# Optional — marketing layout uses a hardcoded Pixel ID in BaseLayout.astro. Same ID as Events Manager if you use this elsewhere.
PUBLIC_META_PIXEL_ID=

# Optional: Formspree form id (path segment only). Contact form posts to https://formspree.io/f/{id}
PUBLIC_FORMSPREE_FORM_ID=

# Required for public PDF -> sequence generator on marketing tools page
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
