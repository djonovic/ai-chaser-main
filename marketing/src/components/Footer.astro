---
const currentYear = new Date().getFullYear();
const appUrl = 'https://app.chaseai.app';

const productLinks = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Invoice Chasing for Freelancers', href: '/invoice-chasing-software-for-freelancers' },
  { label: 'Sequence Generator', href: '/tools/overdue-invoice-sequence-generator' },
];

const resourceLinks = [
  { label: 'How to Chase Unpaid Invoices', href: '/guides/how-to-chase-unpaid-invoices' },
  { label: 'Follow-Up Schedule', href: '/guides/unpaid-invoice-follow-up-schedule' },
  { label: 'Net 30 Overdue Scripts', href: '/guides/net-30-overdue-what-to-send' },
  { label: 'Email Templates', href: '/templates/invoice-reminder-email-template' },
];

const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
];

const legalLinks = [
  { label: 'Cookie Policy', href: '/cookies' },
  { label: 'Acceptable Use', href: '/acceptable-use' },
];
---

<footer class="border-t border-border bg-muted/30" role="contentinfo">
  <div class="container py-12 md:py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-6">
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary">
            <svg class="h-4 w-4 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
          </div>
          <span class="text-lg font-bold tracking-tight">ChaseAI</span>
        </a>
        <p class="text-sm text-muted-foreground max-w-xs leading-relaxed">
          AI-powered invoice chasing that gets you paid faster. Stop chasing payments manually.
        </p>
        <div class="flex items-center gap-4 mt-6">
          <a href="https://www.instagram.com/pakidjonovic/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Instagram">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5a4.25 4.25 0 0 0-4.25-4.25h-8.5z"/><path d="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"/><circle cx="17.3" cy="6.7" r="1.2"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/pakidjonovic/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
        <address class="mt-6 text-xs not-italic text-muted-foreground leading-relaxed">
          Global Bridge MNE LLC<br />
          30 N Gould St Ste N<br />
          Sheridan, WY 82801<br />
          United States
        </address>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">Product</h4>
        <ul class="space-y-3">
          {productLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">Resources</h4>
        <ul class="space-y-3">
          {resourceLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">Company</h4>
        <ul class="space-y-3">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold mb-4">Legal</h4>
        <ul class="space-y-3">
          {legalLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted-foreground">
        &copy; {currentYear} ChaseAI. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Privacy</a>
        <a href="/terms" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Terms</a>
        <a href="/cookies" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
