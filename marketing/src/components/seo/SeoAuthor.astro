---
interface Props {
  date?: string;
}

const {
  date = '2026-04-29',
} = Astro.props;

function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<div class="not-prose flex items-center gap-3 py-4 mb-2">
  <p class="text-sm text-muted-foreground">
    Written by Alex Morgan, Invoice &amp; Payments Expert at ChaseAI &#8226; Last updated {formatDate(date)}
  </p>
</div>
