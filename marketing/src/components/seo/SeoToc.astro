---
interface TocItem {
  id: string;
  label: string;
}

const { items } = Astro.props as { items: TocItem[] };
const uniqueItems = items.filter(
  (item, index) => items.findIndex((other) => other.id === item.id) === index,
);
const shouldRender = uniqueItems.length >= 3;
---

{shouldRender && (
  <nav aria-label="Table of contents" class="mb-6 lg:mb-0 lg:sticky lg:top-24">
    <details class="group" data-toc>
      <summary class="flex cursor-pointer items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground list-none [&::-webkit-details-marker]:hidden lg:cursor-default lg:pointer-events-none">
        <svg
          class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90 lg:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="lg:text-xs lg:font-semibold lg:uppercase lg:tracking-wider">On this page</span>
      </summary>
      <ul class="mt-3 space-y-2 border-l-2 border-border pl-4">
        {uniqueItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="block text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<script>
  function syncTocState() {
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    document.querySelectorAll<HTMLDetailsElement>('details[data-toc]').forEach((toc) => {
      if (isDesktop) toc.open = true;
    });
  }

  syncTocState();
  window.matchMedia('(min-width: 1024px)').addEventListener('change', syncTocState);
  document.addEventListener('astro:page-load', syncTocState);
</script>
