---
interface TocItem {
  id: string;
  label: string;
}

const { items } = Astro.props as { items: TocItem[] };
---

<div class="lg:hidden mb-6">
  <details class="group">
    <summary class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors cursor-pointer">
      <svg
        class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      On this page
    </summary>
    <nav class="mt-3 pl-4 border-l-2 border-border" aria-label="Table of contents">
      <ul class="space-y-2">
        {items.map((item) => (
          <li>
            <a href={`#${item.id}`} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</div>

<nav class="hidden lg:block sticky top-24" aria-label="Table of contents">
  <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
    On this page
  </p>
  <ul class="space-y-2 border-l-2 border-border pl-4">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class="text-sm block text-muted-foreground hover:text-foreground transition-colors"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
