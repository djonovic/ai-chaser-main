---
import { Image } from 'astro:assets';
import authorImage from '../assets/author-image.optimized.jpeg';

interface Props {
  updatedDate?: string;
  global?: boolean;
}

const { updatedDate = 'April 29, 2026', global = false } = Astro.props as Props;
---

{global && (
  <div class="mb-6 inline-flex max-w-3xl items-center gap-4 rounded-2xl border border-border/60 bg-card/60 px-4 py-3 text-left shadow-sm">
    <Image
      src={authorImage}
      width={64}
      height={64}
      loading="lazy"
      alt="Pasko Djonovic, Founder at ChaseAI"
      class="h-14 w-14 shrink-0 rounded-full object-cover object-[center_10%] ring-1 ring-border"
    />
    <p class="text-sm leading-relaxed text-muted-foreground">
      Written by <a href="/author" class="text-foreground hover:underline">Pasko Djonovic</a>, Founder at ChaseAI • Last updated {updatedDate}
    </p>
  </div>
)}
