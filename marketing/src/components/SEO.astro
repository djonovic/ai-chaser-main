---
import SEOHead from './SEOHead.astro';
import authorImage from '../assets/author-image.optimized.jpeg';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object | object[];
}

const props = Astro.props as Props;
const siteUrl = 'https://chaseai.app';
const canonicalUrl = props.canonical || new URL(Astro.url.pathname, siteUrl).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ChaseAI',
  legalName: 'Global Bridge MNE LLC',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: ['https://chaseai.app'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '30 N Gould St Ste N',
    addressLocality: 'Sheridan',
    addressRegion: 'WY',
    postalCode: '82801',
    addressCountry: 'US',
  },
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pasko Djonovic',
  jobTitle: 'Founder',
  url: `${siteUrl}/author`,
  image: new URL(authorImage.src, siteUrl).toString(),
  sameAs: [
    'https://www.linkedin.com/in/pakidjonovic/',
    'https://www.instagram.com/pakidjonovic/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Global Bridge MNE LLC',
  },
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
  ...segments.map((segment, index) => {
    const path = '/' + segments.slice(0, index + 1).join('/');
    const label = segment
      .split('-')
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ');
    return {
      '@type': 'ListItem',
      position: index + 2,
      name: label,
      item: siteUrl + path,
    };
  }),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

const pageSchemas = props.structuredData
  ? (Array.isArray(props.structuredData) ? props.structuredData : [props.structuredData])
  : [];

const mergedSchemas = [organizationSchema, authorSchema, breadcrumbSchema, ...pageSchemas];
---

<SEOHead {...props} canonical={canonicalUrl} structuredData={mergedSchemas} />
