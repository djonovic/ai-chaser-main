---
import SEOHead from './SEOHead.astro';
import authorImage from '../assets/author-image.optimized.jpeg';
import { getCanonicalUrl, SITE_URL } from '../lib/canonical';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object | object[];
  breadcrumbs?: BreadcrumbItem[];
}

const props = Astro.props as Props;
const siteUrl = SITE_URL;
const canonicalUrl = getCanonicalUrl(props.canonical, Astro.url.pathname);
const ogImageUrl = props.ogImage
  ? (props.ogImage.startsWith('http') ? props.ogImage : new URL(props.ogImage, siteUrl).toString())
  : new URL('/og-default.png', siteUrl).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ChaseAI',
  legalName: 'Global Bridge MNE LLC',
  url: siteUrl,
  logo: `${siteUrl}/apple-touch-icon.png`,
  description:
    'ChaseAI is automated invoice chasing software that writes and sends professional payment follow-ups so businesses get paid faster.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '30 N Gould St Ste N',
    addressLocality: 'Sheridan',
    addressRegion: 'WY',
    postalCode: '82801',
    addressCountry: 'US',
  },
};

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pasko Djonovic',
  jobTitle: 'Founder',
  url: `${siteUrl}/author`,
  image: new URL(authorImage.src, siteUrl).toString(),
  sameAs: [
    'https://www.linkedin.com/in/pakidjonovic/',
    'https://www.instagram.com/pakidjonovic/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Global Bridge MNE LLC',
  },
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = props.breadcrumbs
  ? props.breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: crumb.href === '/' ? siteUrl : `${siteUrl}${crumb.href}`,
    }))
  : [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      ...segments.map((segment, index) => {
        const path = '/' + segments.slice(0, index + 1).join('/');
        const label = segment
          .split('-')
          .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
          .join(' ');
        return {
          '@type': 'ListItem',
          position: index + 2,
          name: label,
          item: siteUrl + path,
        };
      }),
    ];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

const pageSchemas = props.structuredData
  ? (Array.isArray(props.structuredData) ? props.structuredData : [props.structuredData])
  : [];

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ChaseAI',
  url: siteUrl,
  inLanguage: 'en-US',
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: props.title,
  description: props.description,
  url: canonicalUrl,
  inLanguage: 'en-US',
};

const normalizedPageSchemas = pageSchemas.map((schema) => {
  if (!schema || typeof schema !== 'object') return schema;
  const typed = schema as Record<string, unknown>;
  const schemaType = typed['@type'];

  if (schemaType === 'Article') {
    return {
      ...typed,
      image: typed.image ?? [ogImageUrl],
      inLanguage: typed.inLanguage ?? 'en-US',
      mainEntityOfPage: typed.mainEntityOfPage ?? canonicalUrl,
    };
  }

  if (schemaType === 'HowTo') {
    return {
      ...typed,
      inLanguage: typed.inLanguage ?? 'en-US',
    };
  }

  return typed;
});

const mergedSchemas = [
  organizationSchema,
  authorSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  ...normalizedPageSchemas,
];
---

<SEOHead {...props} canonical={canonicalUrl} structuredData={mergedSchemas} />
