---
/** Set PUBLIC_META_PIXEL_ID in marketing build env. If unset, no banner (no Meta Pixel on marketing pages). */
const pixelId = (import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined)?.trim() ?? '';
---

{pixelId ? (
  <>
    <div
      id="cookie-consent-banner"
      class="fixed bottom-0 left-0 right-0 z-[100] p-4 md:p-6 pointer-events-none hidden"
      role="dialog"
      aria-labelledby="cookie-consent-title"
      aria-live="polite"
    >
      <div
        class="pointer-events-auto mx-auto max-w-2xl rounded-xl border border-border bg-card p-4 md:p-5 shadow-lg"
      >
        <h2 id="cookie-consent-title" class="text-sm font-semibold text-foreground">
          Cookies & marketing
        </h2>
        <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
          We use essential cookies so the site works. If you choose &ldquo;Accept,&rdquo; we also load the
          Meta (Facebook) Pixel to measure ads and site performance. You can refuse marketing cookies and
          still use the site. See our{' '}
          <a href="/cookies" class="text-primary underline underline-offset-2">Cookie Policy</a>
          {' '}and{' '}
          <a href="/privacy" class="text-primary underline underline-offset-2">Privacy Policy</a>.
        </p>
        <div class="mt-4 flex flex-col-reverse sm:flex-row gap-2 sm:justify-end">
          <button
            type="button"
            id="cookie-consent-essential"
            class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors"
          >
            Essential only
          </button>
          <button
            type="button"
            id="cookie-consent-accept"
            class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
          >
            Accept analytics &amp; marketing
          </button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ pixelId }}>
      (function () {
        var KEY = 'chaseai_cookie_consent';
        var banner = document.getElementById('cookie-consent-banner');
        function showBanner() {
          if (banner) {
            banner.classList.remove('hidden');
          }
        }
        function hideBanner() {
          if (banner) {
            banner.classList.add('hidden');
          }
        }
        function injectPixel(id) {
          if (!id || typeof window === 'undefined') return;
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', id);
          window.fbq('track', 'PageView');
        }
        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {
          stored = null;
        }
        if (stored === 'marketing') {
          injectPixel(pixelId);
          return;
        }
        if (stored === 'essential') {
          return;
        }
        showBanner();
        document.getElementById('cookie-consent-essential')?.addEventListener('click', function () {
          try {
            localStorage.setItem(KEY, 'essential');
          } catch (e) {}
          hideBanner();
        });
        document.getElementById('cookie-consent-accept')?.addEventListener('click', function () {
          try {
            localStorage.setItem(KEY, 'marketing');
          } catch (e) {}
          injectPixel(pixelId);
          hideBanner();
        });
      })();
    </script>
  </>
) : null}
