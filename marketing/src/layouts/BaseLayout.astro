---
import Analytics from '@vercel/analytics/astro';
import SEO from '../components/SEO.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object | object[];
  showAuthorBox?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  structuredData,
  showAuthorBox,
  breadcrumbs,
} = Astro.props as Props;

const pathname = Astro.url.pathname;
const shouldShowAuthorBox =
  typeof showAuthorBox === 'boolean'
    ? showAuthorBox
    : pathname.startsWith('/templates/') || pathname.startsWith('/guides/') || pathname.startsWith('/tools/');
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      structuredData={structuredData}
      breadcrumbs={breadcrumbs}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-16">
      {breadcrumbs && breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
      <slot />
      {shouldShowAuthorBox && (
        <section class="pb-8">
          <div class="container max-w-3xl mx-auto text-center">
            <AuthorBox global={true} />
          </div>
        </section>
      )}
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
