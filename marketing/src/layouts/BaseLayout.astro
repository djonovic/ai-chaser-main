---
import Analytics from '@vercel/analytics/astro';
import SEO from '../components/SEO.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object | object[];
  showAuthorBox?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  structuredData,
  showAuthorBox,
} = Astro.props as Props;

const pathname = Astro.url.pathname;
const shouldShowAuthorBox =
  typeof showAuthorBox === 'boolean'
    ? showAuthorBox
    : pathname.startsWith('/templates/') || pathname.startsWith('/guides/') || pathname.startsWith('/tools/');
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      structuredData={structuredData}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-16">
      <slot />
      {shouldShowAuthorBox && (
        <section class="pb-8">
          <div class="container max-w-3xl mx-auto text-center">
            <AuthorBox global={true} />
          </div>
        </section>
      )}
    </main>
    <Footer />
    <Analytics />
    <script is:inline>
      (function () {
        if (!document.querySelector('.language-mermaid')) return;
        function loadMermaid() {
          var s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
          s.async = true;
          s.defer = true;
          s.onload = function () {
            window.mermaid.initialize({ startOnLoad: false, theme: 'neutral', gantt: { useWidth: 800 } });
            document.querySelectorAll('.language-mermaid').forEach(function (el) {
              var pre = el.closest('pre');
              var container = document.createElement('div');
              container.className = 'mermaid';
              container.textContent = el.textContent;
              if (pre) { pre.replaceWith(container); } else { el.replaceWith(container); }
            });
            window.mermaid.run();
          };
          document.body.appendChild(s);
        }

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadMermaid, { timeout: 2000 });
        } else {
          window.addEventListener('load', loadMermaid, { once: true });
        }
      })();
    </script>
  </body>
</html>
