---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getBlogUrl, getPublishedBlogPosts } from "../../utils/blog";

const posts = await getPublishedBlogPosts();

const title = "Blog | ChaseAI";
const description =
  "Actionable invoice follow-up guides, templates, and automation playbooks to reduce late payments and improve cash flow for freelancers and agencies.";
const canonical = "https://chaseai.app/blog/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="hero-gradient border-b border-border/50">
    <div class="container py-14 md:py-20 max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">ChaseAI Blog</h1>

    </div>
  </section>

  <section class="section-padding">
    <div class="container max-w-4xl mx-auto">
      {posts.length === 0 ? (
        <p class="text-muted-foreground">No published posts yet.</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {posts.map((post) => (
            <article class="rounded-xl border border-border bg-card p-6 transition-shadow hover:shadow-sm h-full">
              <p class="text-sm text-muted-foreground">{formatDate(post.data.pubDate)}</p>
              <h2 class="mt-2 text-xl font-semibold tracking-tight">
                <a href={getBlogUrl(post)} class="hover:text-primary transition-colors">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-muted-foreground leading-relaxed">{post.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
