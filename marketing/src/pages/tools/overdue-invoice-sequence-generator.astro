---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq';
import PublicSequenceGenerator from '../../components/seo/PublicSequenceGenerator';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/tools/overdue-invoice-sequence-generator';
const canonicalUrl = `https://chaseai.app${pageSlug}`;
const metaTitle = 'Overdue Invoice Sequence Generator (AI)';
const metaDescription =
  'Upload an invoice PDF and get a complete overdue invoice email sequence instantly—ready to send or automate. Free to try.';

const tocItems = [
  { id: 'how-it-works', label: 'How it works' },
  { id: 'what-you-get', label: 'What you get' },
  { id: 'example-output', label: 'Example output' },
  { id: 'safe-checklist', label: 'Edit before sending' },
  { id: 'smart-chasing', label: 'Smart Chasing automation' },
  { id: 'faq', label: 'FAQ' },
];

const faqs = [
  {
    q: 'How fast is the overdue invoice sequence generator?',
    a: 'Most invoices generate in about 60 seconds. Complex invoices may take slightly longer if details are missing or ambiguous.',
  },
  {
    q: 'Do emails send automatically after generation?',
    a: 'No. You review and edit each step first, then decide whether to send manually or automate with Smart Chasing.',
  },
  {
    q: 'Can I choose the tone for generated reminders?',
    a: 'Yes. You can start friendly, neutral, or firm and then edit each email before activation.',
  },
  {
    q: 'What if the invoice has no PO number?',
    a: 'The generator still works. You can add PO and delivery proof fields manually before sending to accounts payable.',
  },
  {
    q: 'Can I use this for international clients?',
    a: 'Yes. You can adjust wording, dates, currency formatting, and escalation terms before launch.',
  },
  {
    q: 'Is there a free option?',
    a: 'Yes. You can try the tool free and upgrade to paid tiers as your invoice volume grows.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ChaseAI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: canonicalUrl,
  description: metaDescription,
  dateModified: '2026-03-31',
  screenshot: 'https://chaseai.app/og-default.png',
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
    { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Starter' },
    { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'Pro' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const structuredData = [softwareSchema, faqSchema];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Overdue Invoice Sequence Generator
        <span class="block text-lg md:text-2xl font-semibold text-muted-foreground mt-3">
          Free AI Tool
        </span>
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Stop writing late-payment reminders from scratch. This <strong>overdue invoice sequence generator</strong>
        builds a complete escalation flow from one invoice PDF: friendly opening, firm follow-ups,
        and final notice language. You keep full control because every message is editable before sending.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="#free-generator"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:opacity-95 transition-opacity group"
          aria-label="Upload invoice PDF to generate reminder sequence"
          data-track="invoice_upload_start"
          data-cta-id="hero_upload"
        >
          Upload invoice PDF
          <span class="ml-2 text-primary-foreground/70 text-xs group-hover:text-primary-foreground/90 transition-colors">Takes ~60 seconds</span>
        </a>
        <a
          href="#example-output"
          class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-sm font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Jump to example sequence output"
        >
          See example sequence
        </a>
        <a
          href={appUrl}
          class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-sm font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Start free with ChaseAI"
          data-track="lead_cta_click"
          data-cta-id="hero_start_free"
        >
          Start free
        </a>
      </div>
      <p class="mt-4 text-sm">
        <a href="/pricing" class="text-muted-foreground hover:text-foreground" aria-label="View ChaseAI pricing plans" data-track="lead_cta_click" data-cta-id="hero_pricing">View pricing</a>
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} client:idle />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <h2 id="free-generator" class="scroll-mt-24">Generate a free sequence right now</h2>
          <p>
            Upload your invoice PDF below to generate a real sequence immediately. No account is required
            for this preview tool.
          </p>
          <div class="not-prose my-6">
            <PublicSequenceGenerator client:load />
          </div>

          <h2 id="how-it-works">Upload your invoice → get a full sequence (how it works)</h2>
          <p>
            Manual follow-up fails because it depends on memory and mood. One week you send a perfect
            reminder; the next week you miss the window. This <strong>invoice reminder generator</strong> replaces
            that inconsistency with a repeatable workflow: upload, review, edit, and launch.
          </p>
          <ol>
            <li>Upload invoice PDF (or enter details manually if needed).</li>
            <li>AI extracts client name, amount, due date, and references.</li>
            <li>Generator drafts 5-7 follow-up emails with tone progression.</li>
            <li>You edit each step and confirm schedule.</li>
            <li>Activate Smart Chasing and track opens/replies.</li>
          </ol>
          <p>
            Every draft is yours to adjust. ChaseAI does not force-send anything before your review.
            That review layer is what makes this tool practical for real client relationships.
          </p>

          <div class="not-prose my-6 rounded-xl border border-border bg-muted/20 p-4 text-sm text-muted-foreground">
            <p><strong class="text-foreground">Diagram/GIF production notes</strong></p>
            <ul class="mt-2 space-y-1">
              <li>Input → output flow diagram, alt="Invoice PDF input to generated reminder sequence output"</li>
              <li>Tone ladder diagram, alt="Friendly to firm escalation ladder for overdue reminders"</li>
              <li>Timeline diagram, alt="Overdue invoice reminder send timeline by day"</li>
              <li>GIF: PDF upload → fields extracted → sequence generated → open tracking timeline</li>
            </ul>
          </div>

          <h2 id="what-you-get">What you’ll get (5–7 steps + tone progression)</h2>
          <p>
            The output is not a single email. You get a complete <strong>payment reminder email generator</strong>
            sequence designed around predictable escalation:
          </p>
          <ul>
            <li><strong>Step 1:</strong> Friendly reminder after due date</li>
            <li><strong>Step 2:</strong> Follow-up with explicit payment ask</li>
            <li><strong>Step 3:</strong> Clear overdue status with timing</li>
            <li><strong>Step 4:</strong> Firm second notice</li>
            <li><strong>Step 5:</strong> Consequence framing (per terms)</li>
            <li><strong>Step 6-7:</strong> Final notice and escalation pathway</li>
          </ul>
          <p>
            This progression protects your tone and your cash flow. You stay polite early, but never vague.
            Later steps remain professional while making next actions explicit.
          </p>
          <p>
            If you want to compare with a full copy/paste framework, use this
            <a href="/templates/overdue-invoice-email-sequence"> overdue invoice email sequence template</a>.
          </p>

          <h2 id="example-output">Example output (sample invoice + generated emails)</h2>
          <p>
            Sample input: invoice #2841, $4,500, due 14 days ago, corporate client.
            Generated output includes seven emails from “quick reminder” through “final action required.”
            Subject lines include invoice number and overdue days so AP teams can route fast.
          </p>
          <p>
            Example Step 1 starts with context and one payment link. Step 4 introduces urgency and asks for
            a committed pay date. Step 6 references terms and deadline. Step 7 flags escalation options
            without emotional wording. This structure is why teams use an <strong>AI invoice chaser</strong> instead
            of ad hoc follow-ups.
          </p>

          <h2 id="safe-checklist">What to edit before sending (safe checklist)</h2>
          <p>
            Generated drafts are strong first passes, but final quality depends on your edits.
            Always review for legal and relationship safety before launching.
          </p>
          <ul>
            <li>Confirm invoice number, amount, due date, and payment link.</li>
            <li>Add PO number and delivery proof notes if client uses procurement.</li>
            <li>Match escalation language to your contract terms.</li>
            <li>Remove vague lines and keep one clear action per email.</li>
            <li>Set timezone-aware send times for highest open rates.</li>
          </ul>
          <p>
            For product capabilities and sending controls, visit <a href="/features">features</a>.
            For plan limits and volume pricing, see <a href="/pricing">pricing</a>.
          </p>

          <h2 id="smart-chasing">Automate sending with Smart Chasing</h2>
          <p>
            After edits are approved, Smart Chasing handles timing and follow-through:
            sends each email on schedule, tracks opens, and keeps history in one timeline.
            If a client pays early, you can pause the sequence instantly.
          </p>
          <p>
            This is where automation makes the biggest difference: no missed follow-ups, no
            rewrite fatigue, no guessing which reminder already went out.
          </p>

          <div class="not-prose">
            <SeoCtaBand
              heading="Ready to generate your overdue sequence?"
              description="Upload one invoice PDF and get a complete, editable reminder progression in about 60 seconds."
              primaryHref="#free-generator"
              primaryLabel="Upload invoice PDF"
              primaryAriaLabel="Upload invoice PDF to generate reminder sequence"
              primaryMicrocopy="Takes ~60 seconds"
              secondaryHref="/pricing"
              secondaryLabel="View pricing"
              secondaryAriaLabel="View ChaseAI pricing plans"
            />
          </div>

          <h3>External references</h3>
          <ul class="text-sm">
            <li><a href="https://quickbooks.intuit.com/r/small-business-data/small-business-late-payments-report-2025/" target="_blank" rel="noopener noreferrer">QuickBooks: Small-business late payments report 2025</a></li>
            <li><a href="https://group.atradius.com/knowledge-and-research/reports/b2b-payment-practices-trends%2C-western-europe-2024" target="_blank" rel="noopener noreferrer">Atradius: Western Europe B2B payment practices</a></li>
            <li><a href="https://developers.google.com/search/docs/appearance/structured-data/software-app" target="_blank" rel="noopener noreferrer">Google: Software app structured data guidance</a></li>
            <li><a href="https://developers.google.com/search/docs/appearance/structured-data/sd-policies" target="_blank" rel="noopener noreferrer">Google: Structured data policies</a></li>
            <li><a href="https://stripe.com/resources/more/what-is-a-payment-reminder-how-to-write-and-send-one-successfully" target="_blank" rel="noopener noreferrer">Stripe: Payment reminder best practices</a></li>
          </ul>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">FAQ</h2>
      <SeoFaq items={faqs} client:visible />
    </div>
  </section>

  <section class="section-padding border-t border-border">
    <div class="container max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Build smarter follow-ups in minutes</h2>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        Generate, edit, and automate your sequence with full control over tone and timing.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="#free-generator"
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:opacity-95 transition-opacity group"
          aria-label="Upload invoice PDF to generate reminder sequence"
          data-track="invoice_upload_start"
          data-cta-id="footer_upload"
        >
          Upload invoice PDF
          <span class="ml-2 text-primary-foreground/70 text-xs group-hover:text-primary-foreground/90 transition-colors">Takes ~60 seconds</span>
        </a>
        <a
          href={appUrl}
          class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Start free with ChaseAI"
          data-track="lead_cta_click"
          data-cta-id="footer_start_free"
        >
          Start free
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ pageSlug }}>
    function trackEvent(name, props) {
      try {
        window.dispatchEvent(
          new CustomEvent('chaseai:track', { detail: { event: name, ...props } }),
        );
      } catch (_) {}
    }
    window.trackEvent = trackEvent;

    trackEvent('page_view', { page_slug: pageSlug });

    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-track]');
      if (!el) return;
      var eventName = el.getAttribute('data-track');
      var ctaId = el.getAttribute('data-cta-id') || '';
      trackEvent(eventName, { cta_id: ctaId, page_slug: pageSlug });
    });

    window.addEventListener('chaseai:sequence_generated', function () {
      trackEvent('sequence_generated', { page_slug: pageSlug });
    });

    window.addEventListener('chaseai:smart_chase_started', function () {
      trackEvent('smart_chase_started', { page_slug: pageSlug });
    });
  </script>
</BaseLayout>
