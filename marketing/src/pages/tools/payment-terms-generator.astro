---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import PaymentTermsGenerator from '../../components/tools/PaymentTermsGenerator';

const pageSlug = '/tools/payment-terms-generator';
const canonicalUrl = `https://chaseai.app${pageSlug}`;
const metaTitle = 'Free Payment Terms Generator for Invoices & Contracts | ChaseAI';
const metaDescription =
  'Generate clear, professional payment terms for your invoices and contracts in seconds. Covers due dates, late fees, accepted methods, and dispute clauses. Free, no sign-up required.';
const faqs = [
  { q: 'Are these terms legally binding?', a: 'They are a strong starting point, but you should get legal review for enforceability in your jurisdiction.' },
  { q: 'Can I use these in Stripe or FreshBooks invoices?', a: 'Yes. Copy and paste the generated clause into notes/terms fields in invoicing software.' },
  { q: 'What is the difference between Net 30 and due on receipt?', a: 'Net 30 gives the client 30 days; due on receipt asks for immediate payment.' },
];
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Payment Terms Generator', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const tocItems = [
  { id: 'calculator', label: 'Generator' },
  { id: 'must-include', label: 'What every invoice should include' },
  { id: 'net-comparison', label: 'Net 30 vs Net 14' },
  { id: 'impact', label: 'Late payment impact' },
  { id: 'faq', label: 'FAQ' },
];
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonicalUrl} structuredData={structuredData}>
  <section class="hero-gradient">
    <div class="container py-14 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold">Payment Terms Generator — Create Contract-Ready Payment Clauses in Seconds</h1>
      <p class="mt-5 text-muted-foreground">Vague terms are a major reason invoices go late. This <strong>payment terms generator</strong> builds a clean clause covering due date, methods, late fees, and disputes.</p>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="grid lg:grid-cols-[210px_1fr_180px] gap-10 max-w-6xl mx-auto">
        <aside><SeoToc items={tocItems} /></aside>
        <article class="prose prose-neutral max-w-none prose-a:text-primary">
          <h2 id="calculator">Payment terms generator</h2>
          <div class="not-prose my-5"><PaymentTermsGenerator client:visible /></div>

          <div class="not-prose my-6 rounded-xl border border-primary/20 bg-primary/5 p-4 text-sm">
            <p>Once terms are clear, automate follow-ups so every client sees consistent reminders.</p>
            <a href="https://app.chaseai.app" class="mt-2 inline-flex rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground">Start Free — No Credit Card</a>
          </div>

          <h2 id="must-include">What payment terms should every invoice include</h2>
          <p>At minimum, include due date, accepted methods, late fee policy, and dispute window. Clear terms shorten ambiguity cycles and improve on-time collection.</p>
          <p>Reference: <a href="https://stripe.com/resources/more/what-are-payment-terms-here-is-what-businesses-need-to-know" target="_blank" rel="noopener noreferrer">Stripe payment practices guide</a>.</p>

          <h2 id="net-comparison">Net 30 vs Net 14 vs due on receipt</h2>
          <table>
            <thead><tr><th>Business type</th><th>Best default</th><th>Why</th></tr></thead>
            <tbody>
              <tr><td>Freelancer</td><td>Net 14</td><td>Balances cash flow and client expectations</td></tr>
              <tr><td>Agency</td><td>Net 30</td><td>Matches larger client AP cycles</td></tr>
              <tr><td>SaaS services</td><td>Due on receipt / Net 7</td><td>Recurring model benefits from tighter terms</td></tr>
              <tr><td>Trades</td><td>Deposit + Net 7</td><td>Materials and labor costs need faster coverage</td></tr>
            </tbody>
          </table>

          <h2 id="impact">How payment terms affect late-payment rates</h2>
          <p>Businesses with explicit late-fee wording and clear due dates tend to be paid faster because expectations are unambiguous from day one.</p>
          <p>Try paired tools: <a href="/tools/invoice-late-fee-calculator">Invoice Late Fee Calculator</a> and <a href="/tools/late-payment-cost-calculator">Late Payment Cost Calculator</a>.</p>

          <h3>External references</h3>
          <ul>
            <li><a href="https://stripe.com/resources/more/what-are-payment-terms-here-is-what-businesses-need-to-know" target="_blank" rel="noopener noreferrer">Stripe: What are payment terms?</a></li>
            <li><a href="https://group.atradius.com/knowledge-and-research/reports/b2b-payment-practices-trends%2C-western-europe-2024" target="_blank" rel="noopener noreferrer">Atradius: Payment Practices Report</a></li>
            <li><a href="https://www.xero.com/uk/campaigns/business-insights/" target="_blank" rel="noopener noreferrer">Xero Business Insights</a></li>
          </ul>
          <p><strong>Written by Pasko Djonovic, Founder at ChaseAI • Last updated May 6, 2026</strong></p>
        </article>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">FAQ</h2>
      <SeoFaq items={faqs} />
    </div>
  </section>

  <section class="section-padding border-t border-border">
    <div class="container max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold">Set clearer terms and get paid faster</h2>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a href="#calculator" class="inline-flex rounded-lg bg-primary px-7 py-3 text-sm font-semibold text-primary-foreground">Generate terms</a>
        <a href="https://app.chaseai.app" class="inline-flex rounded-lg border border-border px-7 py-3 text-sm font-semibold">Automate collections</a>
      </div>
    </div>
  </section>
</BaseLayout>
