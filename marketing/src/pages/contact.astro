---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact ChaseAI',
  description: 'Get in touch with the ChaseAI team for questions, support, or partnership inquiries.',
  url: 'https://chaseai.app/contact',
};

const contactOptions = [
  {
    icon: '✉️',
    title: 'Email Support',
    description: 'For general questions, feature requests, and support.',
    action: 'support@chaseai.app',
    actionLabel: 'support@chaseai.app',
    actionType: 'email',
  },
  {
    icon: '💼',
    title: 'Partnerships',
    description: 'Interested in integrations or business partnerships?',
    action: 'partnerships@chaseai.app',
    actionLabel: 'partnerships@chaseai.app',
    actionType: 'email',
  },
  {
    icon: '🐛',
    title: 'Bug Reports',
    description: 'Found something broken? We want to fix it fast.',
    action: 'bugs@chaseai.app',
    actionLabel: 'bugs@chaseai.app',
    actionType: 'email',
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with the ChaseAI team. We're here to help with questions about AI invoice chasing, account support, partnerships, and more."
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="hero-gradient">
    <div class="container py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Get in touch
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto">
          Have a question, feedback, or just want to say hi? We'd love to hear from you. Our team typically responds within 24 hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form + Options -->
  <section class="pb-20 -mt-4">
    <div class="container">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-5 gap-12">
        <!-- Form -->
        <div class="lg:col-span-3">
          <div class="rounded-2xl border border-border bg-card p-6 md:p-8">
            <h2 class="text-xl font-bold mb-6">Send us a message</h2>

            <form
              action="https://formspree.io/f/your-form-id"
              method="POST"
              class="space-y-5"
            >
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-sm font-medium mb-1.5">Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium mb-1.5">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                    placeholder="you@company.com"
                  />
                </div>
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium mb-1.5">Subject</label>
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                >
                  <option value="" disabled selected>Select a topic</option>
                  <option value="general">General Question</option>
                  <option value="support">Account Support</option>
                  <option value="feature">Feature Request</option>
                  <option value="bug">Bug Report</option>
                  <option value="partnership">Partnership</option>
                  <option value="enterprise">Enterprise Inquiry</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium mb-1.5">Message</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="w-full rounded-lg border border-border bg-background px-4 py-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors resize-none"
                  placeholder="How can we help?"
                ></textarea>
              </div>

              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary-600 transition-colors w-full sm:w-auto"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Contact Options -->
        <div class="lg:col-span-2 space-y-4">
          {contactOptions.map(opt => (
            <div class="p-5 rounded-2xl border border-border bg-card">
              <div class="text-2xl mb-3">{opt.icon}</div>
              <h3 class="text-sm font-semibold mb-1">{opt.title}</h3>
              <p class="text-xs text-muted-foreground mb-3">{opt.description}</p>
              {opt.actionType === 'email' ? (
                <a
                  href={`mailto:${opt.action}`}
                  class="text-sm text-primary hover:underline font-medium"
                >
                  {opt.actionLabel}
                </a>
              ) : (
                <span class="text-sm text-primary font-medium">{opt.actionLabel}</span>
              )}
            </div>
          ))}

          <div class="p-5 rounded-2xl border border-primary/20 bg-primary/5">
            <div class="text-2xl mb-3">⚡</div>
            <h3 class="text-sm font-semibold mb-1">Priority Support</h3>
            <p class="text-xs text-muted-foreground mb-3">
              Starter and Pro users get faster response times (under 4 hours) and direct access to our team.
            </p>
            <a href="/pricing" class="text-sm text-primary hover:underline font-medium">
              View plans &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Mini Section -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Before you reach out
        </h2>
        <p class="mt-2 text-muted-foreground">
          Quick answers to common questions.
        </p>
      </div>

      <div class="max-w-2xl mx-auto space-y-4">
        {[
          {
            q: 'How fast do you respond?',
            a: 'We aim to respond within 24 hours for all users. Starter and Pro users get priority support with response times under 4 hours during business hours.',
          },
          {
            q: 'I forgot my password — how do I reset it?',
            a: 'Go to the login page and click "Forgot password" or use our Magic Link option. You\'ll receive a password reset email within minutes.',
          },
          {
            q: 'Can I request a feature?',
            a: 'Absolutely! We love hearing from users. Use the contact form above and select "Feature Request" — every request is reviewed by our team.',
          },
          {
            q: 'Do you offer enterprise plans?',
            a: 'Yes. Enterprise includes everything in Pro plus QuickBooks and Xero integration, mail reply workflows, and dedicated onboarding. Use the form above and select "Enterprise Inquiry" — we\'ll follow up with scope and pricing.',
          },
        ].map(faq => (
          <details class="group rounded-2xl border border-border bg-card overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-medium hover:bg-muted/30 transition-colors list-none [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
