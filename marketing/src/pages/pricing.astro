---
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.chaseai.app';
const appPricingUrl = `${appUrl}/pricing`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ChaseAI Pricing',
  description:
    'ChaseAI pricing: Starter ($9/mo) with a 14-day free trial, and Pro ($19/mo). Cancel anytime.',
  url: 'https://chaseai.app/pricing',
};

const plans = [
  {
    name: 'Starter',
    price: '$9',
    period: '/mo',
    subtitle: '14-day free trial · $108/year billed annually',
    description: 'For freelancers and consultants who are serious about getting paid.',
    features: [
      '14-day free trial',
      'Unlimited invoices',
      '50 sequence generations/month',
      'Email open tracking',
      'Advanced recovery reports',
      'Multi-currency support',
      'PDF invoice extraction',
      'Priority email support',
    ],
    cta: 'Start 14-day free trial',
    ctaStyle: 'primary',
    highlight: true,
    badge: 'Most Popular',
    href: appUrl,
  },
  {
    name: 'Pro',
    price: '$19',
    period: '/mo',
    subtitle: '$228/year billed annually',
    description: 'For power users and growing teams who want no limits.',
    features: [
      'Everything in Starter',
      'Unlimited sequence generations',
      'PDF invoice export',
      'Recovery analytics dashboard',
      'Priority email support',
      'Bring your own Gemini key',
    ],
    cta: 'Choose Pro',
    ctaStyle: 'outline',
    highlight: false,
    badge: null,
    href: appUrl,
  },
];

const faqs = [
  {
    q: 'Is there a free trial?',
    a: 'Yes. Starter includes a 14-day free trial. You add a card at checkout and won’t be charged until the trial ends. Cancel anytime during the trial to avoid charges.',
  },
  {
    q: 'What counts as a "sequence generation"?',
    a: 'Each time you generate a new sequence (AI-generated or from a default template) on an invoice, that counts as one generation. You can regenerate or create new sequences within your monthly limit. Pro includes unlimited generations (or unlimited on any plan when you add your own Gemini API key in Settings).',
  },
  {
    q: 'Can I use my own API key to bypass AI limits?',
    a: 'Yes. Add your Google Gemini API key in Settings and you get unlimited sequence generations on any plan. ChaseAI adds zero markup to API costs.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept all major credit and debit cards. All payments are processed securely through Stripe.',
  },
  {
    q: 'Can I switch plans at any time?',
    a: 'Yes. Upgrade or downgrade anytime from your Settings page. When upgrading, you get immediate access to the new plan features. When downgrading, the change applies at the end of your current billing period.',
  },
  {
    q: 'Is there a contract or commitment?',
    a: 'No. Starter and Pro are month-to-month or annual with no long-term contract. Cancel anytime with one click, no cancellation fees.',
  },
  {
    q: 'Do you offer refunds?',
    a: 'Yes. If you\'re not satisfied within the first 14 days after your first paid charge, contact us for a full refund. No questions asked. During the free trial you can cancel before you\'re charged.',
  },
  {
    q: 'What\'s included in Priority Support?',
    a: 'Priority support means faster response times, direct access to our team, and priority handling of feature requests and bug reports.',
  },
];

const comparisonRows = [
  { feature: 'Free trial', starter: '14 days', pro: '-' },
  { feature: 'Invoices', starter: 'Unlimited', pro: 'Unlimited' },
  { feature: 'Sequence generations', starter: '50/mo', pro: 'Unlimited' },
  { feature: 'Automated email sending', starter: 'Yes', pro: 'Yes' },
  { feature: 'PDF invoice extraction', starter: 'Yes', pro: 'Yes' },
  { feature: 'Client management', starter: 'Yes', pro: 'Yes' },
  { feature: 'Recovery analytics', starter: 'Advanced', pro: 'Advanced' },
  { feature: 'Multi-currency', starter: 'Yes', pro: 'Yes' },
  { feature: 'PDF invoice export', starter: '-', pro: 'Yes' },
  { feature: 'BYOK (own API key)', starter: 'Yes', pro: 'Yes' },
  { feature: 'Support', starter: 'Priority email', pro: 'Priority email' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const structuredData = [pageSchema, faqSchema];
---

<BaseLayout
  title="ChaseAI Pricing | Starter Free Trial + Pro"
  description="ChaseAI plans for freelancers and agencies. Start a 14-day free trial on Starter, then automate invoice reminders with Starter or Pro."
  canonical="https://chaseai.app/pricing"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="hero-gradient">
    <div class="container py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Simple, transparent pricing
        </h1>
        <p class="mt-4 text-lg text-muted-foreground max-w-xl mx-auto">
          Start with a 14-day free trial on Starter. Card required — you won’t be charged until the trial ends. Cancel anytime.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="pb-20 -mt-4">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {plans.map(plan => (
          <div class:list={[
            'flex flex-col p-6 rounded-2xl border bg-card relative',
            plan.highlight ? 'border-2 border-primary shadow-lg shadow-primary/10' : 'border-border',
          ]}>
            {plan.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class:list={[
                  'inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold whitespace-nowrap',
                  plan.highlight ? 'bg-primary text-primary-foreground' : 'border border-primary/30 text-primary bg-background',
                ]}>
                  {plan.badge}
                </span>
              </div>
            )}

            <div>
              <div class="text-sm font-medium text-muted-foreground mb-1">{plan.name}</div>
              <div class="flex items-baseline gap-1 mb-1">
                <span class="text-4xl font-extrabold">{plan.price}</span>
                {plan.period && <span class="text-muted-foreground">{plan.period}</span>}
              </div>
              <p class="text-xs text-muted-foreground mb-1">{plan.subtitle}</p>
              <p class="text-sm text-muted-foreground">{plan.description}</p>
            </div>

            <ul class="mt-6 space-y-3 flex-1">
              {plan.features.map(f => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class="h-4 w-4 text-success shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {f}
                </li>
              ))}
            </ul>

            <div class="mt-6">
              <a
                href={plan.href}
                class:list={[
                  'inline-flex items-center justify-center w-full rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors',
                  plan.ctaStyle === 'primary'
                    ? 'bg-primary text-primary-foreground shadow-sm hover:bg-primary-600'
                    : 'border border-border hover:bg-muted/50',
                ]}
              >
                {plan.cta}
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8 space-y-2">
        <p class="text-sm text-muted-foreground">
          Add your own <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Google Gemini API key</a> in Settings to bypass AI limits on any plan.
        </p>
        <p class="text-xs text-muted-foreground">
          All plans include email support. Prices in USD. Cancel anytime.
        </p>
      </div>
    </div>
  </section>

  <!-- Feature Comparison Table -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Compare plans in detail
        </h2>
      </div>

      <div class="max-w-3xl mx-auto overflow-x-auto">
        <div class="rounded-2xl border border-border bg-card overflow-hidden min-w-[480px]">
          <div class="grid grid-cols-3 bg-muted/50 border-b border-border">
            <div class="px-4 py-3 text-sm font-semibold">Feature</div>
            <div class="px-4 py-3 text-sm font-semibold text-center text-primary">Starter</div>
            <div class="px-4 py-3 text-sm font-semibold text-center">Pro</div>
          </div>
          {comparisonRows.map((row, i) => (
            <div class:list={['grid grid-cols-3', i % 2 === 0 ? 'bg-card' : 'bg-muted/20']}>
              <div class="px-4 py-3 text-sm font-medium">{row.feature}</div>
              <div class="px-4 py-3 text-sm text-center font-medium">{row.starter}</div>
              <div class="px-4 py-3 text-sm text-center font-medium">{row.pro}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border border-border bg-card p-8 md:p-12">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
              The math is simple
            </h2>
            <p class="mt-2 text-muted-foreground">
              ChaseAI pays for itself after recovering just one invoice.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6 text-center">
            <div class="p-5 rounded-xl bg-destructive/5 border border-destructive/10">
              <div class="text-3xl font-extrabold text-destructive">$4,200</div>
              <div class="text-sm text-muted-foreground mt-1">Avg overdue invoice</div>
            </div>
            <div class="p-5 rounded-xl bg-primary/5 border border-primary/10">
              <div class="text-3xl font-extrabold text-primary">$9</div>
              <div class="text-sm text-muted-foreground mt-1">ChaseAI Starter/mo</div>
            </div>
            <div class="p-5 rounded-xl bg-success/5 border border-success/10">
              <div class="text-3xl font-extrabold text-success">467x</div>
              <div class="text-sm text-muted-foreground mt-1">ROI on first recovery</div>
            </div>
          </div>

          <p class="text-center text-sm text-muted-foreground mt-5">
            Most users recover their first overdue invoice within a week. That is a 467x return on a $9/month plan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding border-t border-border bg-muted/20">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center">How to pick the right plan</h2>
      <ul class="mt-4 text-sm text-muted-foreground space-y-2 list-disc pl-5">
        <li>Start with Starter’s 14-day free trial if you send reminders every week.</li>
        <li>Choose Pro if you manage many clients and need unlimited sequence generations.</li>
      </ul>
      <p class="mt-4 text-sm text-muted-foreground text-center">
        You can preview the core flow first with the <a class="text-primary hover:underline" href="/tools/overdue-invoice-sequence-generator">AI Overdue Invoice Sequence Generator</a> (no account required).
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Pricing FAQ
        </h2>
      </div>

      <div class="max-w-2xl mx-auto space-y-4">
        {faqs.map(faq => (
          <details class="group rounded-2xl border border-border bg-card overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-medium hover:bg-muted/30 transition-colors list-none [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Start getting paid faster today
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Start your 14-day free trial and chase invoices in minutes. Cancel anytime.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={appUrl}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary-600 transition-all hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Start free trial
          </a>
          <a
            href={appPricingUrl}
            class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold text-foreground hover:bg-muted/50 transition-all w-full sm:w-auto"
          >
            View Plans
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
