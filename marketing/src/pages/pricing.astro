---
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.chaseai.app';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Pricing - ChaseAI',
  description: 'Simple, transparent pricing for AI-powered invoice chasing. Start free, upgrade when ready.',
  url: 'https://chaseai.app/pricing',
};

const plans = [
  {
    name: 'Free',
    price: '$0',
    period: '/mo',
    subtitle: 'Free forever',
    description: 'For getting started with AI invoice chasing.',
    features: [
      '3 invoices per month',
      'Automated email sending',
      '10 AI sequence generations/month',
      'Basic dashboard',
      'Email support',
    ],
    cta: 'Get Started Free',
    ctaStyle: 'outline',
    highlight: false,
    badge: null,
  },
  {
    name: 'Starter',
    price: '$29',
    period: '/mo',
    subtitle: '$24/mo billed annually — save 17%',
    description: 'For freelancers and consultants who are serious about getting paid.',
    features: [
      'Unlimited invoices',
      '50 AI sequence generations/month',
      'Real-time tracking',
      'Advanced recovery reports',
      'Multi-currency support',
      'PDF invoice extraction',
      'Priority email support',
    ],
    cta: 'Start Free Trial',
    ctaStyle: 'primary',
    highlight: true,
    badge: 'Most Popular',
  },
  {
    name: 'Pro',
    price: '$49',
    period: '/mo',
    subtitle: '$39/mo billed annually — save 20%',
    description: 'For power users and growing teams who want no limits.',
    features: [
      'Everything in Starter',
      'Unlimited AI sequence generations',
      'PDF invoice export',
      'Recovery analytics dashboard',
      'Priority email support',
      'Bring your own Gemini key',
    ],
    cta: 'Try Pro Free for 14 Days',
    ctaStyle: 'outline',
    highlight: false,
    badge: '14-day free trial',
  },
];

const faqs = [
  {
    q: 'Can I start for free?',
    a: 'Yes. The Free plan is free forever — no credit card required. You get 3 invoices per month and 10 AI sequence generations. Upgrade anytime when you need more.',
  },
  {
    q: 'What counts as an "AI sequence generation"?',
    a: 'Each time you click Generate Smart Sequence on an invoice, that counts as one generation. You can regenerate or create new sequences within your monthly limit. Pro users get unlimited generations.',
  },
  {
    q: 'Can I use my own API key to bypass limits?',
    a: 'Yes. Add your free Google Gemini API key in Settings and you get unlimited AI sequence generations on any plan, including Free. ChaseAI adds zero markup to API costs.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept all major credit cards, debit cards, and PayPal. All payments are processed securely through Stripe.',
  },
  {
    q: 'Can I switch plans at any time?',
    a: 'Yes. Upgrade or downgrade anytime from your Settings page. When upgrading, you get immediate access to the new plan features. When downgrading, the change applies at the end of your current billing period.',
  },
  {
    q: 'Is there a contract or commitment?',
    a: 'No. All plans are month-to-month (or annual if you choose). Cancel anytime with one click — no questions asked, no cancellation fees.',
  },
  {
    q: 'Do you offer refunds?',
    a: 'Yes. If you\'re not satisfied within the first 14 days of a paid plan, contact us for a full refund. No questions asked.',
  },
  {
    q: 'What\'s included in Priority Support?',
    a: 'Priority support means faster response times (under 4 hours vs 24 hours), direct access to our team, and priority handling of feature requests and bug reports.',
  },
];

const comparisonRows = [
  { feature: 'Invoices per month', free: '3', starter: 'Unlimited', pro: 'Unlimited' },
  { feature: 'AI sequence generations', free: '10/mo', starter: '50/mo', pro: 'Unlimited' },
  { feature: 'Automated email sending', free: 'Yes', starter: 'Yes', pro: 'Yes' },
  { feature: 'PDF invoice extraction', free: 'Yes', starter: 'Yes', pro: 'Yes' },
  { feature: 'Client management', free: 'Yes', starter: 'Yes', pro: 'Yes' },
  { feature: 'Recovery analytics', free: 'Basic', starter: 'Advanced', pro: 'Advanced' },
  { feature: 'Multi-currency', free: 'Yes', starter: 'Yes', pro: 'Yes' },
  { feature: 'PDF invoice export', free: '—', starter: '—', pro: 'Yes' },
  { feature: 'BYOK (own API key)', free: 'Yes', starter: 'Yes', pro: 'Yes' },
  { feature: 'Support', free: 'Email', starter: 'Priority email', pro: 'Priority email' },
];
---

<BaseLayout
  title="Pricing"
  description="Simple, transparent pricing for ChaseAI. Start free with 3 invoices/month. Upgrade to Starter ($29/mo) or Pro ($49/mo) for unlimited invoices and AI sequences."
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="hero-gradient">
    <div class="container py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight">
          Simple, transparent pricing
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-xl mx-auto">
          Start free. Upgrade when you're ready to automate. Every plan pays for itself by recovering overdue invoices faster.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="pb-20 -mt-4">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {plans.map(plan => (
          <div class:list={[
            'flex flex-col p-6 rounded-2xl border bg-card relative',
            plan.highlight ? 'border-2 border-primary shadow-lg shadow-primary/10' : 'border-border',
          ]}>
            {plan.badge && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class:list={[
                  'inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold whitespace-nowrap',
                  plan.highlight ? 'bg-primary text-primary-foreground' : 'border border-primary/30 text-primary bg-background',
                ]}>
                  {plan.badge}
                </span>
              </div>
            )}

            <div>
              <div class="text-sm font-medium text-muted-foreground mb-1">{plan.name}</div>
              <div class="flex items-baseline gap-1 mb-1">
                <span class="text-4xl font-extrabold">{plan.price}</span>
                <span class="text-muted-foreground">{plan.period}</span>
              </div>
              <p class="text-xs text-muted-foreground mb-1">{plan.subtitle}</p>
              <p class="text-sm text-muted-foreground">{plan.description}</p>
            </div>

            <ul class="mt-6 space-y-3 flex-1">
              {plan.features.map(f => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class="h-4 w-4 text-success shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {f}
                </li>
              ))}
            </ul>

            <div class="mt-6">
              <a
                href={`${appUrl}/auth`}
                class:list={[
                  'inline-flex items-center justify-center w-full rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors',
                  plan.ctaStyle === 'primary'
                    ? 'bg-primary text-primary-foreground shadow-sm hover:bg-primary-600'
                    : 'border border-border hover:bg-muted/50',
                ]}
              >
                {plan.cta}
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8 space-y-2">
        <p class="text-sm text-muted-foreground">
          Add your own <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">free Gemini API key</a> in Settings to bypass AI limits on any plan.
        </p>
        <p class="text-xs text-muted-foreground">
          All plans include email support. Prices in USD. Cancel anytime. No credit card required for Free plan.
        </p>
      </div>
    </div>
  </section>

  <!-- Feature Comparison Table -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Compare plans in detail
        </h2>
      </div>

      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border border-border bg-card overflow-hidden">
          <div class="grid grid-cols-4 bg-muted/50 border-b border-border">
            <div class="px-4 py-3 text-sm font-semibold">Feature</div>
            <div class="px-4 py-3 text-sm font-semibold text-center">Free</div>
            <div class="px-4 py-3 text-sm font-semibold text-center text-primary">Starter</div>
            <div class="px-4 py-3 text-sm font-semibold text-center">Pro</div>
          </div>
          {comparisonRows.map((row, i) => (
            <div class:list={['grid grid-cols-4', i % 2 === 0 ? 'bg-card' : 'bg-muted/20']}>
              <div class="px-4 py-3 text-sm font-medium">{row.feature}</div>
              <div class="px-4 py-3 text-sm text-center text-muted-foreground">{row.free}</div>
              <div class="px-4 py-3 text-sm text-center font-medium">{row.starter}</div>
              <div class="px-4 py-3 text-sm text-center font-medium">{row.pro}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border border-border bg-card p-8 md:p-12">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
              The math is simple
            </h2>
            <p class="mt-2 text-muted-foreground">
              ChaseAI pays for itself after recovering just one invoice.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6 text-center">
            <div class="p-5 rounded-xl bg-destructive/5 border border-destructive/10">
              <div class="text-3xl font-extrabold text-destructive">$4,200</div>
              <div class="text-sm text-muted-foreground mt-1">Avg overdue invoice</div>
            </div>
            <div class="p-5 rounded-xl bg-primary/5 border border-primary/10">
              <div class="text-3xl font-extrabold text-primary">$29</div>
              <div class="text-sm text-muted-foreground mt-1">ChaseAI Starter/mo</div>
            </div>
            <div class="p-5 rounded-xl bg-success/5 border border-success/10">
              <div class="text-3xl font-extrabold text-success">144x</div>
              <div class="text-sm text-muted-foreground mt-1">ROI on first recovery</div>
            </div>
          </div>

          <p class="text-center text-sm text-muted-foreground mt-6">
            Most users recover their first overdue invoice within the first week. That's a 144x return on a $29/month investment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Pricing FAQ
        </h2>
      </div>

      <div class="max-w-2xl mx-auto space-y-4">
        {faqs.map(faq => (
          <details class="group rounded-2xl border border-border bg-card overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-sm font-medium hover:bg-muted/30 transition-colors list-none [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-4 text-sm text-muted-foreground leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Start getting paid faster today
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          No credit card required. Free plan available forever.
        </p>
        <div class="mt-8">
          <a
            href={`${appUrl}/auth`}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary-600 transition-all hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5"
          >
            Start Free — No Credit Card
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
