---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';
import CopyBlock from '../../components/seo/CopyBlock.astro';
import TimelineSteps from '../../components/seo/TimelineSteps.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/late-payment-fee-email-template';
const canonicalUrl = `https://chaseai.app${pageSlug}`;

const metaTitle = 'Invoice Late Fee Wording: 8 Examples + Email Template';
const metaDescription =
  'Copy invoice late fee wording for payment terms, reminders and fee-applied notices. Includes fixed-fee and percentage examples plus an email template.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Templates', href: '/templates' },
  { label: 'Invoice Late Fee Wording', href: pageSlug },
];

const tocItems = [
  { id: 'examples', label: '8 late fee wording examples' },
  { id: 'policy-template', label: 'Late fee policy template' },
  { id: 'fixed-vs-percentage', label: 'Fixed fee vs percentage' },
  { id: 'notify-politely', label: 'How to notify a client politely' },
  { id: 'escalation-path', label: 'Escalation path' },
  { id: 'related', label: 'Related templates and tools' },
  { id: 'faq', label: 'FAQ' },
];

const examples = [
  {
    id: 'footer-wording',
    heading: '1. Invoice footer wording',
    context:
      'Print this at the bottom of every invoice so the fee is never a surprise. It sets the expectation at the moment of billing.',
    text: `Payment is due by [Original due date]. A late fee of [Late fee] applies to balances unpaid after the due date, as set out in our payment terms.`,
  },
  {
    id: 'payment-terms-wording',
    heading: '2. Payment-terms wording',
    context:
      'Use this in the payment-terms section of a proposal, engagement letter or invoice terms page. It defines when the fee starts and how it is calculated.',
    text: `Invoices are payable within [X] days of the invoice date. Balances remaining unpaid after [Original due date] may incur a late fee of [Late fee], applied to the outstanding amount until the balance is settled in full.`,
  },
  {
    id: 'contract-clause-wording',
    heading: '3. Contract-clause wording',
    context:
      'A fuller clause for contracts and master service agreements. Have a legal adviser confirm it fits your jurisdiction before relying on it.',
    text: `Late Payment. If any undisputed invoice remains unpaid after its due date, the Client agrees to pay a late fee of [Late fee] on the outstanding balance. Late fees accrue from the day after the due date until payment is received. This clause does not limit any other remedy available under this agreement or applicable law.`,
  },
  {
    id: 'courtesy-warning',
    heading: '4. Friendly courtesy warning',
    context:
      'Send this once an invoice is a few days overdue but before you actually charge anything. It reminds the client of the terms without applying the fee yet.',
    subject: 'Invoice [Invoice number] overdue - late fee terms apply soon',
    text: `Hi [Client name],

A quick note that invoice [Invoice number] for [Outstanding amount] was due on [Original due date] and is still open.

Our payment terms include a late fee of [Late fee] on overdue balances, but I'd much rather not apply it. If you can settle the invoice in the next few days, no fee will be added.

Pay here: [Payment link]

Thanks,
[Your name]`,
  },
  {
    id: 'warning-before-due',
    heading: '5. Late-fee warning before the due date',
    context:
      'For slow-paying clients, mention the fee just before the due date. It keeps the tone helpful because nothing is overdue yet.',
    subject: 'Invoice [Invoice number] due [Original due date]',
    text: `Hi [Client name],

A friendly reminder that invoice [Invoice number] for [Outstanding amount] is due on [Original due date].

As a heads-up, our terms apply a late fee of [Late fee] to balances that remain unpaid after the due date. Paying by [Original due date] avoids any extra charge.

Pay here: [Payment link]

Best regards,
[Your name]`,
  },
  {
    id: 'fee-applied-email',
    heading: '6. Fee-applied email',
    context:
      'Send this only after the fee has actually been added, and only if your agreement allows it. State the fee, the new total and the payment path - nothing emotional.',
    subject: 'Late fee applied: invoice [Invoice number] - new total [New total]',
    text: `Hi [Client name],

Invoice [Invoice number] was due on [Original due date] and remains unpaid. In line with our agreed payment terms, a late fee of [Late fee] has now been applied.

Original amount: [Outstanding amount]
Late fee: [Late fee]
New total due: [New total]

Please settle the updated balance here: [Payment link]

If the invoice is disputed or already paid, reply to this email and we will review it right away.

Regards,
[Your name]`,
  },
  {
    id: 'fixed-fee-example',
    heading: '7. Fixed-fee example',
    context:
      'A flat charge is easy to explain and predictable for small invoices. Swap the figures for your own terms.',
    text: `A flat late fee of $25 will be added to any invoice unpaid more than 7 days after the due date. Example: invoice [Invoice number] for [Outstanding amount], unpaid 10 days after [Original due date], becomes [New total] ([Outstanding amount] + $25 late fee).`,
  },
  {
    id: 'percentage-example',
    heading: '8. Percentage or monthly-interest example',
    context:
      'Percentage fees scale with invoice size and are common on larger B2B invoices. Many businesses use 1-2% per month, but caps and maximum rates vary by jurisdiction, so confirm what your contract and local law permit.',
    text: `Overdue balances accrue a late fee of 1.5% per month (18% per year), calculated on the outstanding amount from the day after the due date. Example: [Outstanding amount] unpaid for one month accrues a fee of [Late fee], bringing the total due to [New total].`,
  },
];

const faqs = [
  {
    q: 'How do you word a late fee on an invoice?',
    a: 'State the amount or rate, when it starts, and what it applies to in one sentence, for example: "A late fee of 1.5% per month applies to balances unpaid after the due date." Put it in the invoice footer and in your payment terms so clients see it before the invoice is ever late.',
  },
  {
    q: 'Should a late fee appear in the original payment terms?',
    a: 'Yes. A late fee is far easier to apply, and far less likely to be disputed, when the client agreed to it in the contract or payment terms before work started. Adding it to the invoice footer as well keeps it visible at billing time.',
  },
  {
    q: 'Can you add a late fee after an invoice is overdue?',
    a: 'Generally you should not add fees that were never agreed. If your terms did not mention a late fee, send reminders and a past-due notice instead, then update your payment terms for future work. Whether a retroactive fee is enforceable depends on your contract and local law.',
  },
  {
    q: 'Should late fees be fixed or percentage-based?',
    a: 'Fixed fees suit small, similar-sized invoices because they are simple to explain. Percentage or monthly-interest fees scale with invoice value and are more common in B2B contracts. Whichever you choose, apply it consistently and confirm the rate is permitted where you operate.',
  },
  {
    q: 'How do you politely notify a client of a late fee?',
    a: 'Send a courtesy warning first: reference the invoice number, due date and amount, remind them the fee exists in your terms, and give a short window to pay before it is applied. If the fee is then charged, state the calculation and the new total factually, and invite them to reply if anything is disputed.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Pasko Djonovic',
    url: 'https://chaseai.app/author',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Invoice Late Fee Wording You Can Copy
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Eight copy-and-paste examples covering payment terms, invoice footers, courtesy warnings and
        fee-applied emails, with fixed-fee and percentage variants.
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-07-28" />
          <p>
            Good late fee wording does three things: it names the fee amount or rate, says exactly when it
            starts, and points to the terms the client already agreed to. Below are eight examples you can
            copy - from a one-line invoice footer to a full fee-applied email - each with placeholders like
            <code>[Invoice number]</code> and <code>[Late fee]</code> that you replace with your own details.
          </p>

          <div class="not-prose my-6 rounded-xl border border-amber-300/60 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
            <p>
              <strong>Before you charge a fee:</strong> only apply late fees that your agreement or payment
              terms allow, and check the maximum rates permitted by local law where you and your client
              operate. When in doubt, ask a legal adviser - this page is wording guidance, not legal advice.
            </p>
          </div>

          <h2 id="examples">8 late fee wording examples</h2>

          {examples.map((example) => (
            <>
              <h3 id={example.id}>{example.heading}</h3>
              <p>{example.context}</p>
              <CopyBlock label={example.heading.replace(/^\d+\.\s/, '')} subject={example.subject} text={example.text} />
            </>
          ))}

          <h2 id="policy-template">Late fee policy template (for contracts and terms pages)</h2>
          <p>
            If you want a complete <strong>late fee policy</strong> rather than a single sentence, use this
            block in your contract, engagement letter, or terms page. It covers the rate, when the fee starts,
            how it compounds, and what happens if non-payment continues.
          </p>
          <CopyBlock
            label="Late fee policy template"
            text={`Late Payment Policy

1. Payment terms. Invoices are due within [Number] days of the invoice date, by [accepted payment methods].

2. Late fee. Balances unpaid after the due date incur a late fee of [Late fee amount or rate, e.g. 1.5% per month or $25 flat]. The fee is applied on [day fee starts, e.g. the first day after the due date / 7 days after the due date] and on the same day of each following month while the balance remains unpaid.

3. Notice. We will send a reminder before any late fee is applied, and a statement showing the fee calculation and updated total once it is applied.

4. Disputed invoices. If you believe an invoice is incorrect, notify us within [Number] days of the invoice date. Late fees are not applied to amounts under genuine, documented dispute.

5. Continued non-payment. Invoices unpaid [Number] days after the due date may be paused from further work, referred to collections, or pursued through legal channels, and reasonable recovery costs may be added where the law allows.

6. Governing terms. This policy forms part of our agreement and is subject to applicable law in [State/Country].`}
          />
          <p>
            Adjust every placeholder to match what your agreement and local law actually allow — the
            <a href="/tools/invoice-late-fee-calculator"> invoice late fee calculator</a> covers common rates
            by region, and the
            <a href="/tools/payment-terms-generator"> payment terms generator</a> builds the surrounding terms.
          </p>

          <h2 id="fixed-vs-percentage">Fixed fee vs percentage: how to choose</h2>
          <p>
            A <strong>fixed late fee</strong> (for example, $25 after 7 days) is simple to state and works
            well when your invoices are similar sizes. A <strong>percentage or monthly-interest fee</strong>
            (for example, 1.5% per month) scales with invoice value, which suits larger B2B invoices but
            takes one extra sentence to explain. Run your own numbers with the
            <a href="/tools/invoice-late-fee-calculator"> invoice late fee calculator</a> before you commit a
            rate to your terms, and keep the same structure across all clients so enforcement stays
            consistent.
          </p>

          <h2 id="notify-politely">How to notify a client of a late fee politely</h2>
          <ol>
            <li>Reference the invoice number, amount and original due date - facts first.</li>
            <li>Remind them the fee exists in the terms they agreed to, rather than announcing it as new.</li>
            <li>Give a short window to pay before the fee is applied (example 4 above does this).</li>
            <li>If the fee is charged, show the calculation and the new total (example 6).</li>
            <li>Always offer a reply path in case the invoice is disputed or already paid.</li>
          </ol>

          <h2 id="escalation-path">Where late fees fit in your escalation path</h2>
          <p>
            A late fee notice is one step in a wider follow-up sequence, not the first message you send.
            A typical order looks like this:
          </p>

          <TimelineSteps
            title="Timeline: late-fee escalation sequence"
            steps={[
              { window: 'Day 1-6', label: 'Friendly reminder with payment link' },
              { window: 'Day 7-13', label: 'Firm reminder asking for a payment date' },
              { window: 'Day 14-29', label: 'Late fee notice with updated total' },
              { window: 'Day 30-44', label: 'Final notice with deadline and next step' },
              { window: 'Day 45+', label: 'Escalation under your agreement' },
            ]}
          />

          <p>
            Before the fee stage, use a
            <a href="/templates/friendly-payment-reminder-email"> friendly payment reminder email</a> or a
            <a href="/templates/second-invoice-reminder-email"> second payment reminder</a>. After it, move
            to a <a href="/templates/past-due-invoice-notice-template"> past due notice template</a> and, if
            needed, a
            <a href="/templates/final-notice-unpaid-invoice-email"> final notice for the unpaid invoice</a>.
          </p>

          <h2 id="related">Related templates and tools</h2>
          <ul>
            <li>
              <a href="/tools/invoice-late-fee-calculator">Invoice late fee calculator</a> - work out fixed
              and percentage fees on a real balance.
            </li>
            <li>
              <a href="/templates/invoice-reminder-email-template">Invoice reminder email templates</a> - the
              full reminder sequence from first nudge to final demand.
            </li>
            <li>
              <a href="/templates/past-due-invoice-notice-template">Past due invoice notice</a> - formal
              letter and email formats for 30, 60 and 90 days.
            </li>
            <li>
              <a href="/templates/final-notice-unpaid-invoice-email">Final notice templates</a> - the last
              message before escalation.
            </li>
            <li>
              <a href="/best-invoice-chasing-software">Invoice chasing software comparison</a> - tools that
              send these notices for you automatically.
            </li>
          </ul>

          <div class="not-prose">
            <SeoCtaBand
              heading="Automate late-fee notices without drama"
              description="ChaseAI writes and sends friendly, firm and fee-stage reminders for you, so terms get enforced consistently."
              primaryHref={appUrl}
              primaryLabel="Generate my sequence"
              primaryAriaLabel="Generate late fee reminder sequence"
              secondaryHref="/pricing"
              secondaryLabel="View pricing"
              secondaryAriaLabel="View pricing plans"
            />
          </div>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">
        Invoice late fee wording FAQ
      </h2>
      <SeoFaq items={faqs} />
    </div>
  </section>
</BaseLayout>
