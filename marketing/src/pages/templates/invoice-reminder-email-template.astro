---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';
import CopyBlock from '../../components/seo/CopyBlock.astro';
import TimelineSteps from '../../components/seo/TimelineSteps.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/invoice-reminder-email-template';
const canonicalUrl = `https://chaseai.app${pageSlug}`;

const metaTitle = 'Invoice Reminder Email Templates: 7 Copy-and-Send Examples';
const metaDescription =
  'Copy 7 invoice reminder email templates from friendly first notice to final demand. Includes subject lines, timing and payment follow-up wording.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Templates', href: '/templates' },
  { label: 'Invoice Reminder Email Templates', href: pageSlug },
];

const tocItems = [
  { id: 'sequence', label: 'Which reminder to send when' },
  { id: 'templates', label: 'The 7 templates' },
  { id: 'essentials', label: 'What every reminder must include' },
  { id: 'faq', label: 'FAQ' },
];

const stages = [
  {
    id: 'before-due',
    heading: '1. Before the due date',
    note: 'A courtesy note a few days out. Prevents "I forgot" and surfaces disputes early.',
    href: '/templates/friendly-payment-reminder-email',
    linkText: 'More pre-due and friendly wording: friendly payment reminder emails',
    subject: 'Invoice [Invoice number] due [Original due date]',
    text: `Hi [Client name],

A quick note that invoice [Invoice number] for [Outstanding amount] is due on [Original due date]. Payment link: [Payment link]

If anything about the invoice needs adjusting, let me know before the due date.

Thanks,
[Your name]`,
  },
  {
    id: 'due-today',
    heading: '2. Due today',
    note: 'Send the morning it falls due. Factual, short, zero pressure.',
    href: '/templates/friendly-payment-reminder-email',
    linkText: 'Full due-today and day-one variants: friendly reminder templates',
    subject: 'Invoice [Invoice number] is due today',
    text: `Hi [Client name],

Just a reminder that invoice [Invoice number] for [Outstanding amount] is due today. You can pay here: [Payment link]

Thanks for keeping it on your radar.

Best,
[Your name]`,
  },
  {
    id: 'friendly-overdue',
    heading: '3. Friendly overdue reminder',
    note: 'A few days past due. Still assume good faith - most invoices at this stage are oversights.',
    href: '/templates/overdue-invoice-email-template',
    linkText: 'Day-by-day overdue wording: overdue invoice email templates',
    subject: 'Friendly reminder: invoice [Invoice number] past due',
    text: `Hi [Client name],

Invoice [Invoice number] for [Outstanding amount] was due on [Original due date] and looks unpaid on our side - I'm sure it just slipped through.

Here's the payment link: [Payment link]. If it's already been sent, ignore this and thank you!

Best,
[Your name]`,
  },
  {
    id: 'second-reminder',
    heading: '4. Second reminder',
    note: 'No reply to the first? Ask for a specific payment date - that is the entire upgrade.',
    href: '/templates/second-invoice-reminder-email',
    linkText: 'Ten variants including AP and broken-promise wording: 2nd payment reminder emails',
    subject: 'Second reminder: invoice [Invoice number] - payment date needed',
    text: `Hi [Client name],

Following up on invoice [Invoice number] for [Outstanding amount], now [X] days overdue. Could you confirm your expected payment date today?

Payment link: [Payment link]. If something is blocking payment, reply and I'll help resolve it.

Thanks,
[Your name]`,
  },
  {
    id: 'firm-reminder',
    heading: '5. Firm reminder',
    note: 'Two or more weeks overdue with no committed date. Direct language, a deadline, and a named next step.',
    href: '/templates/firm-payment-reminder-email',
    linkText: 'Full firm-stage wording and escalation rules: firm payment reminder email',
    subject: 'Invoice [Invoice number] - response required by [reply-by date]',
    text: `Hi [Client name],

Invoice [Invoice number] for [Outstanding amount] is now [X] days overdue and I haven't received a response to my previous reminders.

Please confirm payment, or a payment date, by [reply-by date]. If I don't hear back, I'll need to move this to our formal overdue process.

Payment link: [Payment link]

Regards,
[Your name]`,
  },
  {
    id: 'final-notice',
    heading: '6. Final notice',
    note: 'The genuinely last message before escalation. Factual summary, hard deadline, cautious consequence wording.',
    href: '/templates/final-notice-unpaid-invoice-email',
    linkText: 'Letter formats and deadline variations: final notice templates',
    subject: 'Final notice: invoice [Invoice number]',
    text: `Dear [Client name],

Despite previous reminders, invoice [Invoice number] for [Outstanding amount] (due [Original due date]) remains unpaid.

Please pay the full balance by [payment deadline]: [Payment link]

If we do not receive payment or hear from you by that date, we may need to escalate this matter, subject to our agreement and applicable law. Contact us immediately if the invoice is disputed.

Sincerely,
[Your name]`,
  },
  {
    id: 'ap-follow-up',
    heading: '7. Accounts-payable follow-up',
    note: 'When payment runs through an AP department, references matter more than tone.',
    href: '/templates/email-to-accounts-payable-overdue-invoice',
    linkText: 'All five AP variants with attachment checklists: accounts payable follow-up emails',
    subject: 'Invoice [Invoice number] / PO [PO number] - past due',
    text: `Hello Accounts Payable team,

Invoice [Invoice number] (PO [PO number]) for [Outstanding amount] was due on [Original due date] and is unpaid. A copy is attached.

Could you confirm it's approved for payment and share the scheduled payment date?

Thank you,
[Your name]
[Phone / email]`,
  },
];

const faqs = [
  {
    q: 'How do you politely remind a client about an invoice?',
    a: 'State the facts - invoice number, amount, due date - assume good faith, and make paying effortless with a payment link. "I\u2019m sure it slipped through" does more work than any pressure tactic in the first two weeks.',
  },
  {
    q: 'How many payment reminders should I send?',
    a: 'A typical sequence is four to six touches: a pre-due note, a due-today or day-one reminder, a second reminder, a firm reminder, and a final notice around day 30. Consistency matters more than volume.',
  },
  {
    q: 'What is the best schedule for invoice reminder emails?',
    a: 'A reliable default: 3 days before due, on the due date, 3-5 days overdue, day 7-10 (second reminder), day 14 (firm), day 30 (final notice). Adjust for your industry\u2019s payment norms - the follow-up schedule guide covers day-by-day timing.',
  },
  {
    q: 'Should invoice reminders be sent automatically?',
    a: 'For more than a handful of invoices a month, yes. The main failure mode of manual chasing is inconsistency - reminders that go out late or not at all. Automation keeps the sequence running while you stay in control of wording.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Pasko Djonovic',
    url: 'https://chaseai.app/author',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Invoice Reminder Email Templates for Every Stage
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Seven copy-and-send reminders covering the whole cycle - before due, due today, overdue, second
        reminder, firm, final notice and accounts payable - each linked to a full page of variants.
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-07-28" />
          <p>
            The right invoice reminder depends on one thing: how overdue the invoice is. This page gives you
            one strong, copyable template for each stage of the follow-up cycle, plus a link to the full
            library for that stage when you need more variants, subject lines or letter formats.
          </p>

          <h2 id="sequence">Which reminder to send when</h2>
          <TimelineSteps
            title="The invoice reminder sequence at a glance"
            steps={[
              { window: 'Day -3', label: 'Courtesy note before the due date' },
              { window: 'Day 0', label: 'Due-today reminder' },
              { window: 'Day 3-6', label: 'Friendly overdue reminder' },
              { window: 'Day 7-13', label: 'Second reminder (ask for a payment date)' },
              { window: 'Day 14-29', label: 'Firm reminder with deadline' },
              { window: 'Day 30+', label: 'Final notice, then formal past-due process' },
            ]}
          />
          <p>
            For the reasoning behind this timing, see the
            <a href="/guides/unpaid-invoice-follow-up-schedule"> unpaid invoice follow-up schedule</a>.
          </p>

          <h2 id="templates">The 7 invoice reminder templates</h2>

          {stages.map((stage) => (
            <>
              <h3 id={stage.id}>{stage.heading}</h3>
              <p>{stage.note}</p>
              <CopyBlock
                label={stage.heading.replace(/^\d+\.\s/, '')}
                subject={stage.subject}
                text={stage.text}
              />
              <p>
                <a href={stage.href}>{stage.linkText}</a>
              </p>
            </>
          ))}

          <h2 id="essentials">What every invoice reminder must include</h2>
          <ul>
            <li>Invoice number and amount</li>
            <li>Original due date (and days overdue, once late)</li>
            <li>A payment link or clear payment instructions</li>
            <li>One specific ask - pay now, or confirm a payment date</li>
            <li>A reply path for disputes or questions</li>
          </ul>
          <p>
            Subject lines carry more weight than most people expect - a reminder that is never opened
            cannot get you paid. Browse
            <a href="/templates/payment-reminder-email-subject-lines"> 50 payment reminder subject lines</a>
            grouped by the same stages as this page. And if your terms include late fees, use proper
            <a href="/templates/late-payment-fee-email-template"> invoice late fee wording</a> rather than
            improvising it in a reminder.
          </p>

          <div class="not-prose">
            <SeoCtaBand
              heading="Send the whole sequence automatically"
              description="ChaseAI drafts all seven stages from your invoice and sends each one on schedule until you're paid."
              primaryHref={appUrl}
              primaryLabel="Start free trial"
              primaryAriaLabel="Start ChaseAI free trial"
              secondaryHref="/tools/overdue-invoice-sequence-generator"
              secondaryLabel="Try the free generator"
              secondaryAriaLabel="Try the free overdue invoice sequence generator"
            />
          </div>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">
        Invoice reminder FAQ
      </h2>
      <SeoFaq items={faqs} />
    </div>
  </section>
</BaseLayout>
