---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/past-due-invoice-notice-template';
const canonicalUrl = `https://chaseai.app${pageSlug}`;

// META (DO NOT CHANGE)
const metaTitle = 'Past Due Invoice Notice Template (Formal)';
const metaDescription =
  'A formal past due invoice notice you can send by email. Perfect for 30+ days overdue: summary, deadline, and documentation checklist.';

const tocItems = [
  { id: 'formal-template', label: 'The formal template (with invoice summary table)' },
  { id: 'not-received', label: 'Not received / dispute wording' },
  { id: 'documentation', label: 'Documentation checklist' },
  { id: 'what-next', label: 'What to do next (AP, final notice)' },
  { id: 'automate', label: 'Automate' },
  { id: 'faq', label: 'FAQ' },
];

const faqs = [
  {
    q: 'When should I send a formal past due invoice notice?',
    a: 'Most teams send a formal notice once an invoice passes 30 days overdue or after repeated reminders are ignored.',
  },
  {
    q: 'What should a past due notice email include?',
    a: 'Include invoice summary, amount due, original due date, final deadline, payment method, and supporting documents.',
  },
  {
    q: 'How formal should the wording be?',
    a: 'Use clear operational language without emotional wording. Formal means specific and documented, not hostile.',
  },
  {
    q: 'What comes after a past due invoice notice?',
    a: 'If unpaid, route through AP and then move to a final notice with clear escalation terms.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-03-31',
  author: {
    '@type': 'Person',
    name: 'Alex Morgan',
    url: 'https://chaseai.app/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema]}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Past Due Invoice Notice (Formal Email Template)
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Use this <strong>past due invoice notice template</strong> for 30+ day overdue balances when you need a
        clear, formal message with documented details.
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} client:idle />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-03-31" />
          <p>
            A formal <strong>past due notice email</strong> should read like a clean account summary plus required
            next step. Keep it factual, short, and easy for AP or finance to process.
          </p>

          <h2 id="formal-template">The formal template (with invoice summary table)</h2>
          <p>
            Subject: "Past due notice: invoice #[number] - action required"
          </p>
          <p>
            "Hi [Name/AP team], this is a formal notice that invoice #[number] remains unpaid.
            Please review the invoice summary and complete payment by [deadline/timezone]."
          </p>
          <div class="not-prose my-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead class="bg-muted/40">
                <tr>
                  <th class="p-3 text-left">Field</th>
                  <th class="p-3 text-left">Value</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-t border-border"><td class="p-3">Invoice Number</td><td class="p-3">#[number]</td></tr>
                <tr class="border-t border-border"><td class="p-3">Invoice Date</td><td class="p-3">[date]</td></tr>
                <tr class="border-t border-border"><td class="p-3">Original Due Date</td><td class="p-3">[date]</td></tr>
                <tr class="border-t border-border"><td class="p-3">Days Overdue</td><td class="p-3">[X]</td></tr>
                <tr class="border-t border-border"><td class="p-3">Amount Due</td><td class="p-3">[amount]</td></tr>
                <tr class="border-t border-border"><td class="p-3">Payment Link/Details</td><td class="p-3">[link/details]</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            "If payment has already been made, please share remittance details so I can update records.
            If there is any processing issue, reply today with the blocker and expected resolution date.
            Thank you, [Your Name]"
          </p>

          <h2 id="not-received">"Not received" / dispute wording</h2>
          <p>
            If the client says "not received" or raises a dispute, keep wording neutral and evidence-based:
          </p>
          <ul>
            <li><strong>Not received:</strong> "Resending invoice #[number] and attachments for confirmation."</li>
            <li><strong>Missing PO:</strong> "Please share PO reference so I can update and reissue if needed."</li>
            <li><strong>Amount dispute:</strong> "Please specify disputed line item so we can resolve quickly."</li>
            <li><strong>Vendor details issue:</strong> "Sharing legal entity and remittance details again for setup."</li>
          </ul>
          <p>
            This keeps your <strong>overdue invoice notice</strong> professional while moving the thread toward
            concrete resolution.
          </p>

          <h2 id="documentation">Documentation checklist</h2>
          <ul>
            <li>Invoice PDF (current and correct version).</li>
            <li>PO number or written no-PO confirmation.</li>
            <li>Delivery/milestone proof if services were delivered.</li>
            <li>Payment terms excerpt (late fee, due date, escalation terms).</li>
            <li>Remittance details and pay-now link.</li>
            <li>Previous reminder trail in the same thread.</li>
          </ul>
          <p>
            Formal notices work best when AP can process the payment from one email without asking for missing docs.
          </p>

          <h2 id="what-next">What to do next (AP, final notice)</h2>
          <p>
            After this notice, use a strict decision path:
          </p>
          <ul>
            <li>If AP confirms payment date, monitor and follow up only if missed.</li>
            <li>If AP requests missing data, send full packet same day.</li>
            <li>If no progress, escalate to final notice by your set deadline.</li>
          </ul>
          <p>
            For AP-specific language use
            <a href="/templates/email-to-accounts-payable-overdue-invoice"> email to accounts payable overdue invoice</a>.
            For end-stage escalation use
            <a href="/templates/final-notice-unpaid-invoice-email"> final notice unpaid invoice email</a>.
          </p>

          <div class="not-prose my-6 rounded-xl border border-primary/10 bg-primary/5 p-4 text-sm text-muted-foreground">
            <p><strong class="text-foreground">Quick tips</strong></p>
            <ul class="mt-2 space-y-1">
              <li>Use "formal notice" wording only after earlier reminders.</li>
              <li>Include summary table for faster AP handling.</li>
              <li>Set one deadline with timezone.</li>
              <li>Keep all communication in a single thread.</li>
            </ul>
          </div>

          <div class="not-prose my-6 rounded-xl border border-border bg-muted/20 p-4 text-sm">
            <p class="font-semibold mb-2">Timeline: formal notice to escalation</p>
            <pre class="overflow-x-auto"><code class="language-mermaid">gantt
    title Past Due Notice Escalation
    dateFormat  YYYY-MM-DD
    axisFormat  %d %b
    section Sequence
    Friendly reminders        :d1, 2026-04-01, 13d
    Firm reminder             :d14, 2026-04-14, 16d
    Past due formal notice    :d30, 2026-04-30, 10d
    Final notice window       :d40, 2026-05-10, 5d
    Post-final escalation     :d45, 2026-05-15, 1d</code></pre>
          </div>

          <h2 id="automate">Automate</h2>
          <p>
            Generate first reminder through formal notice and final escalation from one invoice using the
            <a href="/tools/overdue-invoice-sequence-generator"> overdue invoice sequence generator</a>.
          </p>
          <ol>
            <li>Upload invoice details once.</li>
            <li>Generate staged reminders with tone progression.</li>
            <li>Set timing, deadlines, and escalation rules.</li>
            <li>Track replies and payment completion.</li>
          </ol>

          <div class="not-prose">
            <SeoCtaBand
              heading="Automate formal past-due notices"
              description="Build a complete reminder sequence from first nudge to final escalation in minutes."
              primaryHref={appUrl}
              primaryLabel="Generate my sequence"
              primaryAriaLabel="Generate past due invoice sequence"
              secondaryHref="/pricing"
              secondaryLabel="View pricing"
              secondaryAriaLabel="View pricing plans"
            />
          </div>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">Frequently asked questions</h2>
      <SeoFaq items={faqs} client:visible />
    </div>
  </section>
</BaseLayout>
