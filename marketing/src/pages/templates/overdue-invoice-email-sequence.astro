---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/overdue-invoice-email-sequence';
const canonicalUrl = `https://chaseai.app${pageSlug}`;
const metaTitle = 'Automated Overdue Invoice Email Sequence: 7 Steps + Timing';
const metaDescription =
  'Deploy a complete overdue invoice email sequence: 7 steps with send days, tone progression, stop conditions and automation setup for unpaid invoices.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Templates', href: '/templates' },
  { label: 'Overdue Invoice Email Sequence', href: pageSlug },
];

const tocItems = [
  { id: 'why-sequences', label: 'Why sequences work' },
  { id: 'seven-steps', label: 'The 7-step sequence' },
  { id: 'timing-logic', label: 'Timing logic and stop conditions' },
  { id: 'subject-lines', label: 'Subject lines per step' },
  { id: 'reply-scenarios', label: 'Reply scenarios + responses' },
  { id: 'automate', label: 'Deploy the sequence' },
  { id: 'faq', label: 'FAQ' },
];

const sequence = [
  {
    step: 1,
    day: 'Day 1 overdue',
    tone: 'Friendly',
    subject: 'Quick follow-up: invoice #[number]',
    body: `Hi [Name],

Just a quick reminder that invoice #[number] for [amount] was due on [date].

Payment link: [link]

If you already sent payment, please ignore this note.

Thanks,
[Your name]`,
  },
  {
    step: 2,
    day: 'Day 4',
    tone: 'Friendly + specific',
    subject: 'Checking status on invoice #[number]',
    body: `Hi [Name],

Following up on invoice #[number] ([amount]). Could you share expected payment timing?

Payment link: [link]

Appreciate it,
[Your name]`,
  },
  {
    step: 3,
    day: 'Day 7',
    tone: 'Neutral',
    subject: 'Invoice #[number] is now 7 days overdue',
    body: `Hi [Name],

Invoice #[number] for [amount] is now 7 days overdue. Please confirm the payment date.

Payment link: [link]

Best,
[Your name]`,
  },
  {
    step: 4,
    day: 'Day 14',
    tone: 'Firm',
    subject: 'Second notice: invoice #[number]',
    body: `Hi [Name],

This is a second notice for invoice #[number] ([amount]), now 14 days overdue.

Please process by [date] or reply with the blocker so we can resolve quickly.

Payment link: [link]

Regards,
[Your name]`,
  },
  {
    step: 5,
    day: 'Day 21',
    tone: 'Firm + consequence',
    subject: 'Action needed: overdue invoice #[number]',
    body: `Hi [Name],

Invoice #[number] remains unpaid after 21 days. Per terms, late fees may apply after [date].

Please arrange payment now: [link]

Thanks,
[Your name]`,
  },
  {
    step: 6,
    day: 'Day 30',
    tone: 'Final notice',
    subject: 'Final reminder before escalation: #[number]',
    body: `Hi [Name],

This is a final reminder for invoice #[number] ([amount]), now 30 days overdue.

If payment is not received by [date], we will move to the next escalation step.

Pay now: [link]

[Your name]`,
  },
  {
    step: 7,
    day: 'Day 45+',
    tone: 'Escalation',
    subject: 'Unresolved balance: invoice #[number]',
    body: `Hi [Name],

Despite prior reminders, invoice #[number] remains unpaid. If unresolved by [date], we will proceed with [collections/legal/process].

Please reply immediately to finalize payment arrangements.

[Your name]`,
  },
];

const faqs = [
  {
    q: 'How long should an overdue invoice email sequence be?',
    a: 'A 7-step sequence across 30-45 days works well for most freelancers and agencies. It gives clients enough chances to pay while keeping pressure consistent.',
  },
  {
    q: 'What is the difference between a sequence and one-off reminders?',
    a: 'A sequence has predefined send days, tone progression, and escalation logic. One-off reminders are usually inconsistent and easier for clients to ignore.',
  },
  {
    q: 'When should I send a final notice?',
    a: 'Most teams send a final notice at around Day 30, after multiple documented reminders and clear payment links.',
  },
  {
    q: 'Can I automate this sequence without losing control?',
    a: 'Yes. You can generate all seven emails, edit each one, and only start when the sequence reflects your tone and terms.',
  },
  {
    q: 'Should I include late fees in the sequence?',
    a: 'Include late-fee language only if your contract allows it. Introduce it in later steps (usually Step 5 or 6) for best results.',
  },
  {
    q: 'What if they partially pay?',
    a: 'Acknowledge receipt, state the remaining balance, and continue the sequence with updated amount and due date.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Pasko Djonovic',
    url: 'https://chaseai.app/author',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/apple-touch-icon.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const structuredData = [articleSchema, faqSchema];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-16 md:py-24 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Overdue Invoice Email Sequence
        <span class="block text-lg md:text-2xl font-semibold text-muted-foreground mt-3">
          A Complete Automated Campaign
        </span>
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        This page covers the whole campaign: send days, tone progression, stop conditions and how to
        deploy it as automation. If you just need individual emails to send by hand, use the
        <a href="/templates/overdue-invoice-email-template" class="text-primary hover:underline">overdue invoice email templates by day</a>
        instead.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={appUrl}
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:opacity-95 transition-opacity group"
          aria-label="Generate overdue invoice follow-up sequence"
          data-track="lead_cta_click"
          data-cta-id="hero_primary"
        >
          Generate my 7-step sequence
          <span class="ml-2 text-primary-foreground/70 text-xs group-hover:text-primary-foreground/90 transition-colors">14-day free trial</span>
        </a>
        <a
          href="#step-1"
          class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-sm font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Jump to Step 1 template"
        >
          Copy Step 1
        </a>
        <a
          href="#step-5"
          class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-sm font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Jump to Step 5 template"
        >
          Copy Step 5
        </a>
      </div>
      <p class="mt-4 text-sm">
        <a href="/pricing" class="text-muted-foreground hover:text-foreground" aria-label="View ChaseAI pricing plans" data-track="lead_cta_click" data-cta-id="hero_pricing">See pricing</a>
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-03-31" />
          <h2 id="why-sequences">Why sequences beat “random chasing”</h2>
          <p>
            Most teams do not have a cash-flow problem. They have a follow-up consistency problem.
            Random reminders get delayed, rewritten, or sent with mixed tone. Clients notice that.
            A defined <strong>invoice follow up sequence</strong> fixes three things at once: timing,
            clarity, and escalation discipline.
          </p>
          <p>
            Timing matters because payment priorities shift daily on the client side. If your reminder
            lands once and disappears, your invoice often drops below procurement tasks, payroll,
            and urgent vendor requests. Sequence-based reminders keep your invoice visible without
            emotional language. Clarity matters because busy AP teams action complete records faster.
            Every message should include invoice number, amount, due date, and payment path.
            Escalation discipline matters because clients respond better to predictable rules than
            occasional frustration.
          </p>
          <p>
            A good <strong>invoice chasing email sequence</strong> starts friendly, becomes specific,
            then becomes firm only when needed. If you need a softer opener before Step 1,
            use this <a href="/templates/friendly-payment-reminder-email">friendly payment reminder email</a>.
            If the thread reaches later-stage risk, switch to the
            <a href="/templates/final-notice-unpaid-invoice-email"> final notice unpaid invoice template</a>.
          </p>

          <div class="not-prose my-6 rounded-xl border border-border bg-muted/20 p-4">
            <p class="text-sm text-muted-foreground">
              <strong class="text-foreground">Stats callout:</strong> Late payments remain widespread across small businesses.
              Review the latest data in the
              <a href="https://quickbooks.intuit.com/r/small-business-data/small-business-late-payments-report-2025/" target="_blank" rel="noopener noreferrer"> QuickBooks 2025 late payments report</a>.
            </p>
          </div>

          <h2 id="seven-steps">The 7-step sequence (with send days + tone)</h2>
          <p>
            The sequence below is designed for unpaid invoices that are already overdue. Send days are
            practical defaults; adjust for your client cycle if needed. The key is to avoid large gaps.
          </p>

          <div class="not-prose space-y-4">
            {sequence.map((s) => (
              <div class="rounded-lg border border-border bg-muted/20 p-4 md:p-5" id={`step-${s.step}`}>
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">
                    {s.step}
                  </span>
                  <h3 class="text-sm font-semibold">
                    Step {s.step}: {s.day} — <span class="font-normal text-muted-foreground">{s.tone}</span>
                  </h3>
                </div>
                <p class="text-xs text-muted-foreground mb-2">
                  <strong>Subject:</strong> {s.subject}
                </p>
                <pre class="text-sm text-muted-foreground leading-relaxed whitespace-pre-line font-sans">{s.body}</pre>
              </div>
            ))}
          </div>

          <h2 id="timing-logic">Timing logic, stop conditions and personalization</h2>
          <p>
            An automated sequence is only safe when it knows when to <em>stop</em>. Configure these rules
            before activating anything:
          </p>
          <ul>
            <li><strong>Stop on payment:</strong> the moment the invoice is settled, all remaining steps cancel. This is non-negotiable - one reminder after payment costs more goodwill than five before it.</li>
            <li><strong>Pause on reply:</strong> any client response pauses the sequence until you resolve the thread. A disputed invoice must never keep receiving escalation emails.</li>
            <li><strong>Pause on promise:</strong> if the client commits to a date, pause until that date passes - then resume with missed-promise wording, not the next generic step.</li>
            <li><strong>Send-day gaps:</strong> keep 3-7 days between early steps and up to 14 days at later stages. Larger gaps lose momentum; smaller ones feel like spam.</li>
            <li><strong>Personalization:</strong> every step should carry the invoice number, amount, due date and payment link pulled from the actual invoice - plus the client's name and, for firms, their PO reference.</li>
            <li><strong>Business-hours sending:</strong> schedule sends for the client's morning, mid-week where possible.</li>
          </ul>

          <h2 id="subject-lines">Subject lines per step</h2>
          <p>
            Subject lines should mirror sequence tone. Early messages perform better when neutral and
            concise. Mid-stage reminders should include overdue timing. Final-stage lines should include
            action language without threats. This pattern supports a high-response
            <strong> dunning email sequence</strong>:
          </p>
          <ul>
            <li><strong>Step 1:</strong> “Quick follow-up: invoice #[number]”</li>
            <li><strong>Step 2:</strong> “Checking status on invoice #[number]”</li>
            <li><strong>Step 3:</strong> “Invoice #[number] is now 7 days overdue”</li>
            <li><strong>Step 4:</strong> “Second notice: invoice #[number]”</li>
            <li><strong>Step 5:</strong> “Action needed: overdue invoice #[number]”</li>
            <li><strong>Step 6:</strong> “Final reminder before escalation: #[number]”</li>
            <li><strong>Step 7:</strong> “Unresolved balance: invoice #[number]”</li>
          </ul>

          <h2 id="reply-scenarios">If they reply: 5 common scenarios + exact responses</h2>
          <p>
            Replies are where most teams lose momentum. Keep responses short, factual, and next-step driven.
          </p>
          <ol>
            <li>
              <strong>“Talk to finance.”</strong><br />
              “Thanks. Looping finance now. Invoice #[number], [amount], due [date] attached with payment link [link]. Please confirm expected payment date.”
            </li>
            <li>
              <strong>“We paid already.”</strong><br />
              “Thanks for the update. Please share remittance reference so I can match and close the invoice on our side.”
            </li>
            <li>
              <strong>“Need PO / proof.”</strong><br />
              “Attached: updated invoice PDF, PO #[number], and delivery confirmation. Please confirm queue status and payment date.”
            </li>
            <li>
              <strong>“Cash flow is tight this month.”</strong><br />
              “Understood. We can accept [installment option] if you confirm dates today. Please reply with preferred plan so we can document it.”
            </li>
            <li>
              <strong>No reply after final notice.</strong><br />
              “Invoice #[number] remains unresolved. Per terms, next escalation begins [date]. Reply today to resolve before that step.”
            </li>
          </ol>

          <h2 id="automate">Automate the sequence (upload invoice PDF)</h2>
          <p>
            Manual follow-up breaks when you are busy. Automation keeps timing intact, tone consistent,
            and records complete. Use the
            <a href="/tools/overdue-invoice-sequence-generator"> overdue invoice sequence generator</a> to
            extract invoice fields, draft all seven emails, and schedule sends automatically.
          </p>
          <ol>
            <li>Upload invoice PDF</li>
            <li>Generate 7-step sequence</li>
            <li>Edit each step for tone and terms</li>
            <li>Click “Start Smart Chasing” and track opens/replies</li>
          </ol>

          <div class="not-prose">
            <SeoCtaBand
              heading="Generate your personalized sequence in one click"
              description="Upload an overdue invoice and get a full 7-step progression with editable drafts."
              primaryHref={appUrl}
              primaryLabel="Generate my 7-step sequence"
              primaryAriaLabel="Generate overdue invoice follow-up sequence"
              primaryMicrocopy="14-day free trial"
              secondaryHref="/pricing"
              secondaryLabel="See pricing"
              secondaryAriaLabel="View ChaseAI pricing plans"
            />
          </div>

          <h3>Sources</h3>
          <ul class="text-sm">
            <li><a href="https://quickbooks.intuit.com/r/small-business-data/small-business-late-payments-report-2025/" target="_blank" rel="noopener noreferrer">QuickBooks: Late payments report 2025</a></li>
            <li><a href="https://stripe.com/resources/more/what-is-a-payment-reminder-how-to-write-and-send-one-successfully" target="_blank" rel="noopener noreferrer">Stripe: Payment reminder guidance</a></li>
            <li><a href="https://quickbooks.intuit.com/learn-support/en-global/help-article/invoicing/send-invoice-reminders-automatically-manually/L84cQjpxo_ROW_en" target="_blank" rel="noopener noreferrer">QuickBooks: Send reminders automatically/manually</a></li>
            <li><a href="https://central.xero.com/s/article/Set-up-invoice-reminders" target="_blank" rel="noopener noreferrer">Xero: Set up invoice reminders</a></li>
            <li><a href="https://www.zoho.com/us/books/help/settings/reminders.html" target="_blank" rel="noopener noreferrer">Zoho Books: Reminder settings</a></li>
          </ul>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="section-padding border-t border-border bg-muted/20">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center">Before you send: quick quality check</h2>
      <ul class="mt-4 text-sm text-muted-foreground space-y-2 list-disc pl-5">
        <li>Confirm invoice number, amount due, and payment link in every step.</li>
        <li>Keep one action per email: confirm payment date or pay now.</li>
        <li>Escalate by timeline (Day 1, 7, 14, 30), not frustration.</li>
      </ul>
      <p class="mt-4 text-sm text-muted-foreground">
        Need a faster workflow? Try our Free AI Overdue Invoice Sequence Generator - no sign-up required: <a class="text-primary hover:underline" href="/tools/overdue-invoice-sequence-generator">overdue invoice sequence generator</a>.
      </p>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">FAQ</h2>
      <SeoFaq items={faqs} />
    </div>
  </section>

  <section class="section-padding border-t border-border">
    <div class="container max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Stop random chasing. Start smart sequencing.</h2>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        Generate, edit, and schedule your full sequence from one invoice in minutes.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={appUrl}
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:opacity-95 transition-opacity group"
          aria-label="Generate overdue invoice follow-up sequence"
          data-track="lead_cta_click"
          data-cta-id="footer_primary"
        >
          Generate my 7-step sequence
          <span class="ml-2 text-primary-foreground/70 text-xs group-hover:text-primary-foreground/90 transition-colors">14-day free trial</span>
        </a>
        <a
          href={`${appUrl}/invoice/upload`}
          class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold hover:bg-muted/50 transition-colors"
          aria-label="Upload invoice PDF to generate reminders"
          data-track="invoice_upload_start"
          data-cta-id="footer_upload"
        >
          Upload invoice PDF
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ pageSlug }}>
    function trackEvent(name, props) {
      try {
        window.dispatchEvent(
          new CustomEvent('chaseai:track', { detail: { event: name, ...props } }),
        );
      } catch (_) {}
    }
    window.trackEvent = trackEvent;

    trackEvent('page_view', { page_slug: pageSlug });

    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-track]');
      if (!el) return;
      var eventName = el.getAttribute('data-track');
      var ctaId = el.getAttribute('data-cta-id') || '';
      trackEvent(eventName, { cta_id: ctaId, page_slug: pageSlug });
    });

    // Hooks for embedded/interactive generator states.
    window.addEventListener('chaseai:sequence_generated', function () {
      trackEvent('sequence_generated', { page_slug: pageSlug });
    });
    window.addEventListener('chaseai:smart_chase_started', function () {
      trackEvent('smart_chase_started', { page_slug: pageSlug });
    });
  </script>
</BaseLayout>
