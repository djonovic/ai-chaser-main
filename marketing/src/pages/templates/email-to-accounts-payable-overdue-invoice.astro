---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';
import CopyBlock from '../../components/seo/CopyBlock.astro';
import TimelineSteps from '../../components/seo/TimelineSteps.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/email-to-accounts-payable-overdue-invoice';
const canonicalUrl = `https://chaseai.app${pageSlug}`;

const metaTitle = '5 Accounts Payable Follow-Up Email Templates for Overdue Invoices';
const metaDescription =
  'Copy 5 AP follow-up emails for overdue invoices, missing POs, payment-date requests and escalation. Includes subject lines and an attachment checklist.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Templates', href: '/templates' },
  { label: 'Accounts Payable Follow-Up', href: pageSlug },
];

const tocItems = [
  { id: 'templates', label: 'The 5 AP templates' },
  { id: 'proof-pack', label: 'AP attachment checklist' },
  { id: 'timeline', label: 'AP follow-up timeline' },
  { id: 'related', label: 'Related templates' },
  { id: 'faq', label: 'FAQ' },
];

const templates = [
  {
    id: 'standard-follow-up',
    heading: '1. Standard overdue invoice follow-up',
    when: 'Your default AP email once an invoice passes its due date. Lead with reference numbers so AP can match it in their system instantly.',
    checklist: 'Attach: copy of the invoice. Reference: invoice number, PO number, amount, due date.',
    subject: 'Invoice [Invoice number] / PO [PO number] - now past due',
    text: `Hello Accounts Payable team,

Invoice [Invoice number] (PO [PO number]) for [Outstanding amount] was due on [Original due date] and is showing as unpaid on our side.

Invoice number: [Invoice number]
PO number: [PO number]
Invoice date: [Invoice date]
Amount: [Outstanding amount]
Supplier: [Your company name], supplier ID [Supplier ID]

I've attached a copy of the invoice. Could you confirm it is approved for payment and let me know the scheduled payment date?

Thank you,
[Your name]
[Phone / email]`,
  },
  {
    id: 'payment-date-request',
    heading: '2. Request for a confirmed payment date',
    when: 'AP has acknowledged the invoice but not committed to a date. Make the date the only ask so the reply is easy.',
    checklist: 'Reference: invoice number, PO number, prior correspondence date. No new attachments usually needed.',
    subject: 'Payment date for invoice [Invoice number]?',
    text: `Hello [AP contact name],

Thanks for confirming that invoice [Invoice number] (PO [PO number], [Outstanding amount]) is in your system.

Could you share the scheduled payment date? If it's already in a payment run, the run date is all I need for our records.

Kind regards,
[Your name]`,
  },
  {
    id: 'missing-po',
    heading: '3. Missing purchase order or reference',
    when: 'AP cannot process the invoice because a PO number or internal reference is missing or does not match. Fix their blocker in one email.',
    checklist: 'Attach: corrected invoice. Reference: original invoice number, correct PO number, name of the person who placed the order.',
    subject: 'Corrected reference for invoice [Invoice number]',
    text: `Hello [AP contact name],

I understand invoice [Invoice number] could not be processed due to a missing or mismatched purchase order reference.

The correct reference is PO [PO number], approved by [Approver name] in your [Department] team. I've attached an updated copy of the invoice showing this PO number.

Could you confirm the invoice can now be processed, and the expected payment date? The original due date was [Original due date], so I'd appreciate it being included in your next payment run.

Thank you,
[Your name]`,
  },
  {
    id: 'not-in-system',
    heading: '4. Invoice not found in the AP system',
    when: '"We never received it" - the most common AP response. Resend everything and ask for receipt confirmation so it cannot go missing twice.',
    checklist: 'Attach: invoice copy, proof of original delivery (send timestamp or portal submission ID). Reference: invoice number, PO number, original send date.',
    subject: 'Resending invoice [Invoice number] - please confirm receipt',
    text: `Hello Accounts Payable team,

I understand invoice [Invoice number] is not showing in your system. I originally sent it on [Original send date]; it may not have reached you.

I've reattached the invoice (PO [PO number], [Outstanding amount], due [Original due date]).

Could you reply to confirm receipt, and let me know the expected payment date given the invoice is now past its original due date? If your team needs anything else to register it - supplier forms, bank verification, portal submission - tell me and I'll provide it today.

Thank you,
[Your name]
[Phone / email]`,
  },
  {
    id: 'escalation',
    heading: '5. Escalation after no response',
    when: 'Two or more follow-ups have gone unanswered. Copy your business contact or the finance manager, summarize the history, and set a reply-by date.',
    checklist: 'Attach: invoice copy. Reference: dates of each previous follow-up, invoice and PO numbers, total days overdue. CC: your business contact or finance manager.',
    subject: 'Escalation: invoice [Invoice number] unpaid, [X] days overdue',
    text: `Hello [Finance manager name],

I'm escalating invoice [Invoice number] (PO [PO number]) for [Outstanding amount], now [X] days past its due date of [Original due date].

I contacted accounts payable on [date of first follow-up] and [date of second follow-up] but haven't received a payment date. A copy of the invoice is attached.

Could you confirm by [reply-by date] when payment will be made? If there is an issue with the invoice, I'm happy to resolve it immediately - please just let me know what's needed.

Regards,
[Your name]
[Your company name]
[Phone / email]`,
  },
];

const faqs = [
  {
    q: 'What should an email to accounts payable include?',
    a: 'Everything AP needs to process payment without replying: invoice number, PO number, invoice date, due date, amount and currency, your supplier ID, payment details, and a copy of the invoice attached. Missing references are the top reason supplier invoices stall.',
  },
  {
    q: 'How often should I follow up with accounts payable?',
    a: 'Every 4 to 7 business days is a practical cadence. AP teams work in payment runs, so weekly follow-ups usually land once per run cycle without feeling like spam.',
  },
  {
    q: 'What if AP says they never received the invoice?',
    a: 'Resend the invoice as an attachment, include the original send date or portal submission ID as proof, and ask them to confirm receipt in writing. Then request a payment date in the same email so the thread ends with a commitment.',
  },
  {
    q: 'Who should I escalate to beyond accounts payable?',
    a: 'First your day-to-day business contact (they approved the work), then the finance manager or controller. Escalate when two follow-ups have gone unanswered or a promised payment date has been missed.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Pasko Djonovic',
    url: 'https://chaseai.app/author',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/apple-touch-icon.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        Accounts Payable Follow-Up Email Templates
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Five copyable AP emails for overdue invoices - standard follow-up, payment-date request, missing
        PO, invoice not found and escalation - with subject lines and attachment checklists.
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-07-28" />
          <p>
            AP teams pay invoices they can match, approve and schedule - so the fastest way to get paid is
            an email that contains every reference they need in one place. This is the workhorse version;
            copy it, fill in the placeholders, attach the invoice, and send. Four more variants for specific
            blockers follow below.
          </p>

          <CopyBlock
            label="Standard AP follow-up (start here)"
            subject="Invoice [Invoice number] / PO [PO number] - now past due"
            text={templates[0].text}
          />

          <h2 id="templates">The 5 accounts payable email templates</h2>

          {templates.map((template) => (
            <>
              <h3 id={template.id}>{template.heading}</h3>
              <p><strong>When to use it:</strong> {template.when}</p>
              <p><strong>Checklist:</strong> {template.checklist}</p>
              <CopyBlock
                label={template.heading.replace(/^\d+\.\s/, '')}
                subject={template.subject}
                text={template.text}
              />
            </>
          ))}

          <h2 id="proof-pack">AP attachment and reference checklist</h2>
          <p>
            Before any AP follow-up, confirm your email or attachments cover every item below. One missing
            reference can push payment to the next run cycle.
          </p>
          <ul>
            <li>Correct legal entity (bill the company name AP has on file, not the brand name)</li>
            <li>Invoice number</li>
            <li>PO number or internal reference</li>
            <li>Invoice date</li>
            <li>Due date</li>
            <li>Amount and currency</li>
            <li>Supplier ID (if you're registered in their system)</li>
            <li>Payment details (bank account, remittance email)</li>
            <li>Copy of the invoice attached as PDF</li>
            <li>Proof of delivery or approval, when relevant</li>
            <li>A named contact person and phone number</li>
            <li>Your requested payment date</li>
          </ul>

          <h2 id="timeline">AP follow-up timeline</h2>
          <TimelineSteps
            title="Timeline: AP follow-up plan"
            steps={[
              { window: 'Day 1', label: 'Standard overdue follow-up to AP' },
              { window: 'Day 4-7', label: 'Payment-date request (or blocker fix)' },
              { window: 'Day 8-11', label: 'Second follow-up, CC your business contact' },
              { window: 'Day 12-17', label: 'Escalation to finance manager' },
              { window: 'Day 18-29', label: 'Firm reminder with reply-by date' },
              { window: 'Day 30+', label: 'Final notice and formal past-due process' },
            ]}
          />

          <h2 id="related">Related templates</h2>
          <ul>
            <li><a href="/templates/second-invoice-reminder-email">2nd payment reminder email</a> - when your contact is a person, not an AP inbox.</li>
            <li><a href="/templates/past-due-invoice-notice-template">Past due notice template</a> - the formal notice format for 30/60/90 days.</li>
            <li><a href="/guides/unpaid-invoice-follow-up-schedule">Invoice follow-up schedule</a> - the day-by-day timing strategy.</li>
            <li><a href="/templates/final-notice-unpaid-invoice-email">Final notice for an unpaid invoice</a> - the last step before escalation.</li>
            <li><a href="/best-invoice-chasing-software">Invoice chasing software</a> - tools that run this whole sequence automatically.</li>
          </ul>

          <div class="not-prose">
            <SeoCtaBand
              heading="Stop chasing AP inboxes manually"
              description="ChaseAI drafts reference-complete follow-ups from your invoice and sends them on schedule until you're paid."
              primaryHref={appUrl}
              primaryLabel="Start free trial"
              primaryAriaLabel="Start ChaseAI free trial"
              secondaryHref="/pricing"
              secondaryLabel="View pricing"
              secondaryAriaLabel="View pricing plans"
            />
          </div>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">
        Accounts payable follow-up FAQ
      </h2>
      <SeoFaq items={faqs} />
    </div>
  </section>
</BaseLayout>
