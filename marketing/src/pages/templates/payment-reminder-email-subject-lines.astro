---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoToc from '../../components/seo/SeoToc.astro';
import SeoCtaBand from '../../components/seo/SeoCtaBand';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import SeoAuthor from '../../components/seo/SeoAuthor.astro';

const appUrl = 'https://app.chaseai.app';
const pageSlug = '/templates/payment-reminder-email-subject-lines';
const canonicalUrl = `https://chaseai.app${pageSlug}`;

const metaTitle = '50 Payment Reminder Email Subject Lines: Friendly to Final';
const metaDescription =
  'Copy 50 payment reminder subject lines for friendly, overdue, second-reminder and final-notice emails, with invoice examples for every stage.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Templates', href: '/templates' },
  { label: 'Payment Reminder Subject Lines', href: pageSlug },
];

const groups = [
  {
    id: 'before-due',
    title: '1. Before the due date',
    note: 'Neutral and helpful - the invoice is not late yet, so the subject should read as service, not pressure.',
    href: '/templates/friendly-payment-reminder-email',
    linkLabel: 'friendly payment reminder templates',
    lines: [
      'Invoice [Invoice number] due [Original due date] - payment details inside',
      'Heads-up: invoice [Invoice number] due next week',
      '[Company name] invoice [Invoice number] - due in 3 days',
      'Upcoming payment: invoice [Invoice number] due [Original due date]',
      'Invoice [Invoice number] - everything you need to pay by [Original due date]',
    ],
  },
  {
    id: 'due-today',
    title: '2. Due today',
    note: 'State the fact plainly. "Due today" in the subject is often enough to trigger same-day payment.',
    href: '/templates/friendly-payment-reminder-email',
    linkLabel: 'due-today reminder templates',
    lines: [
      'Invoice [Invoice number] is due today',
      'Due today: invoice [Invoice number] for [Outstanding amount]',
      'Friendly note: invoice [Invoice number] due today',
      'Payment due today - invoice [Invoice number]',
      'Invoice [Invoice number] due today - pay in one click',
    ],
  },
  {
    id: 'recently-overdue',
    title: '3. One to seven days overdue',
    note: 'Move from "reminder" to "past due" language, but keep the tone matter-of-fact - most invoices in this window are oversights.',
    href: '/templates/overdue-invoice-email-template',
    linkLabel: 'overdue invoice email templates by day',
    lines: [
      'Invoice [Invoice number] is now past due',
      'Overdue: invoice [Invoice number] ([Outstanding amount])',
      'Invoice [Invoice number] - 3 days past due',
      'Quick check: invoice [Invoice number] went past due this week',
      'Payment update needed: invoice [Invoice number]',
    ],
  },
  {
    id: 'friendly',
    title: '4. Friendly reminder',
    note: 'For good clients and early follow-ups. Warm words ("quick", "gentle", "checking in") lower the temperature.',
    href: '/templates/friendly-payment-reminder-email',
    linkLabel: 'friendly payment reminder emails',
    lines: [
      'Quick reminder: invoice [Invoice number]',
      'Friendly follow-up on invoice [Invoice number]',
      'Gentle nudge: invoice [Invoice number] balance',
      'Checking in on invoice [Invoice number]',
      'Just making sure invoice [Invoice number] reached you',
    ],
  },
  {
    id: 'second-reminder',
    title: '5. Second reminder',
    note: 'Say "second reminder" explicitly - it signals sequence stage and quietly tells the client a firmer message comes next.',
    href: '/templates/second-invoice-reminder-email',
    linkLabel: '2nd payment reminder email templates',
    lines: [
      'Second reminder: invoice [Invoice number]',
      '2nd reminder: invoice [Invoice number] still open',
      'Following up again: invoice [Invoice number]',
      'Invoice [Invoice number] - second follow-up',
      'Reminder 2 of 3: invoice [Invoice number] outstanding',
    ],
  },
  {
    id: 'firm',
    title: '6. Firm reminder',
    note: 'Two or more weeks overdue with no committed date. Use action words ("response required", "action needed") without threats.',
    href: '/templates/firm-payment-reminder-email',
    linkLabel: 'firm payment reminder templates',
    lines: [
      'Invoice [Invoice number] is [X] days overdue - response required',
      'Action needed: invoice [Invoice number] remains unpaid',
      'Invoice [Invoice number]: please confirm payment by [reply-by date]',
      'Unpaid invoice [Invoice number] - deadline approaching',
      "Invoice [Invoice number] overdue - let's resolve this week",
    ],
  },
  {
    id: 'final-notice',
    title: '7. Final notice',
    note: 'Reserve "final notice" for the genuinely last message before escalation. Using it earlier destroys its effect.',
    href: '/templates/final-notice-unpaid-invoice-email',
    linkLabel: 'final notice templates',
    lines: [
      'Final notice: invoice [Invoice number]',
      'Final reminder before escalation: invoice [Invoice number]',
      'Invoice [Invoice number]: final notice - payment due by [deadline date]',
      'Last reminder: invoice [Invoice number] ([Outstanding amount])',
      'Final notice of outstanding balance: invoice [Invoice number]',
    ],
  },
  {
    id: 'accounts-payable',
    title: '8. Accounts payable',
    note: 'AP teams triage by reference numbers. Lead with the invoice and PO number so your email matches their system.',
    href: '/templates/email-to-accounts-payable-overdue-invoice',
    linkLabel: 'accounts payable follow-up templates',
    lines: [
      'Invoice [Invoice number] / PO [PO number]: payment status request',
      'AP follow-up: invoice [Invoice number] due [Original due date]',
      'Supplier invoice [Invoice number] - approval and payment date?',
      'Remittance query: invoice [Invoice number]',
      'Invoice [Invoice number] not yet paid - is anything missing for processing?',
    ],
  },
  {
    id: 'payment-date',
    title: '9. Payment-date request',
    note: 'When you need a commitment, put the question in the subject. Questions get answered more often than statements.',
    href: '/templates/second-invoice-reminder-email#missing-payment-date',
    linkLabel: 'payment-date follow-up template',
    lines: [
      'When can we expect payment for invoice [Invoice number]?',
      'Invoice [Invoice number]: payment date needed',
      'Please confirm a payment date - invoice [Invoice number]',
      'Payment schedule for invoice [Invoice number]?',
      'Invoice [Invoice number]: can you confirm timing today?',
    ],
  },
  {
    id: 'short',
    title: '10. Short subject lines',
    note: 'Under 30 characters, ideal on mobile where longer subjects get cut off. Pair with a fuller first line of body text.',
    href: '/templates/invoice-reminder-email-template',
    linkLabel: 'invoice reminder email templates',
    lines: [
      'Invoice [Invoice number] overdue',
      'Invoice [Invoice number] - reminder',
      'Payment reminder',
      '[Outstanding amount] outstanding',
      'Re: invoice [Invoice number]',
    ],
  },
];

const totalLines = groups.reduce((sum, group) => sum + group.lines.length, 0);

const faqs = [
  {
    q: 'What is the best payment reminder email subject line format?',
    a: 'Invoice number + status + clear action, for example: "Invoice #2481 overdue - please confirm payment date." The invoice number lets the client find it instantly, and the action tells them exactly what to do.',
  },
  {
    q: 'Should I mention overdue days in the subject line?',
    a: 'Yes, from the second reminder onward. "Invoice #2481 - 14 days overdue" adds real urgency without sounding aggressive, because it is simply a fact.',
  },
  {
    q: 'How many subject lines should I rotate across a sequence?',
    a: 'Use 3 to 5 variants across a follow-up sequence. Identical subjects thread together in the inbox and get skimmed; wildly different ones lose continuity.',
  },
  {
    q: 'When should I switch from friendly to firm subject lines?',
    a: 'Usually after 7 to 14 days overdue, or as soon as a promised payment date is missed. Match the subject line to the stage of the email behind it.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle,
  description: metaDescription,
  datePublished: '2026-03-31',
  dateModified: '2026-07-28',
  author: {
    '@type': 'Person',
    name: 'Pasko Djonovic',
    url: 'https://chaseai.app/author',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ChaseAI',
    url: 'https://chaseai.app',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chaseai.app/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const tocItems = [
  ...groups.map((group) => ({ id: group.id, label: group.title.replace(/^\d+\.\s/, '') })),
  { id: 'construction', label: 'How to write a strong subject line' },
  { id: 'faq', label: 'FAQ' },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonicalUrl}
  ogType="article"
  structuredData={[articleSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://app.chaseai.app" />
  </Fragment>

  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-14 md:py-20 max-w-3xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-balance">
        50 Payment Reminder Email Subject Lines You Can Copy
      </h1>
      <p class="mt-6 text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
        Grouped by stage - before due, due today, overdue, second reminder, firm, final notice and
        accounts payable - with a note on when each tone works.
      </p>
    </div>
  </section>

  <section class="">
    <div class="container">
      <div class="grid lg:grid-cols-[200px_1fr_200px] gap-10 max-w-6xl mx-auto">
        <aside>
          <SeoToc items={tocItems} />
        </aside>

        <article class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg">
          <SeoAuthor date="2026-07-28" />
          <p>
            The best reminder email fails if it is never opened. Below are {totalLines} subject lines
            organized by stage of the follow-up cycle - swap in your own invoice number, amount and dates
            using the placeholders, and match the tone to how overdue the invoice actually is.
          </p>

          {groups.map((group) => (
            <>
              <h2 id={group.id}>{group.title}</h2>
              <p>{group.note}</p>
              <ul>
                {group.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              <p>
                Need the matching email body? Use these <a href={group.href}>{group.linkLabel}</a>.
              </p>
            </>
          ))}

          <h2 id="construction">How to write a strong payment reminder subject line</h2>
          <ul>
            <li><strong>Include the invoice number</strong> when the client deals with multiple invoices - it lets them (or their AP team) act without searching.</li>
            <li><strong>Make the action clear</strong>: "confirm payment date" or "payment due by [date]" beats a vague "following up".</li>
            <li><strong>Do not go aggressive early.</strong> "URGENT" or "FINAL" on a one-week-overdue invoice burns goodwill and dulls your real final notice.</li>
            <li><strong>Keep it scannable</strong>: front-load the key words, since mobile inboxes cut subjects around 35-45 characters.</li>
            <li><strong>Avoid false urgency.</strong> Only name deadlines and consequences you will actually follow through on.</li>
            <li><strong>Use the client or company name sparingly</strong> - it helps when you invoice a large organization, and adds nothing for a client you email weekly.</li>
          </ul>

          <div class="not-prose">
            <SeoCtaBand
              heading="Get subject lines matched to your invoice automatically"
              description="ChaseAI writes the subject line and the email for every stage, based on amount, due date and days overdue."
              primaryHref="/tools/overdue-invoice-sequence-generator"
              primaryLabel="Generate my sequence"
              primaryAriaLabel="Generate a payment reminder sequence with subject lines"
              secondaryHref="/pricing"
              secondaryLabel="View pricing"
              secondaryAriaLabel="View pricing plans"
            />
          </div>
        </article>

        <div class="hidden lg:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section id="faq" class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-center mb-8">
        Subject line FAQ
      </h2>
      <SeoFaq items={faqs} />
    </div>
  </section>
</BaseLayout>
