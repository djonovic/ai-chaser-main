---
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.chaseai.app';
const appPricingUrl = `${appUrl}/pricing`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ChaseAI',
  url: 'https://chaseai.app',
  description: 'AI-powered invoice chasing software for freelancers and small businesses.',
  foundingDate: '2026',
};

const values = [
  {
    icon: '🎯',
    title: 'Freelancers first',
    description: 'We build for the solo operator — the designer, developer, consultant, or agency owner who does it all. Every feature is designed for people who don\'t have an accounting department.',
  },
  {
    icon: '🤖',
    title: 'AI that actually helps',
    description: 'We don\'t use AI as a buzzword. Our AI generates genuinely useful, contextual emails that you\'d be proud to send. Every message is unique, not a template with variables swapped in.',
  },
  {
    icon: '🔓',
    title: 'Transparent & fair',
    description: 'No hidden fees on self-serve plans, no surprise charges, no vendor lock-in. Bring your own API key if you want. We earn your business by being useful — and Enterprise customers get a team that ships integrations with them.',
  },
  {
    icon: '⚡',
    title: 'Simple over complex',
    description: 'We don\'t try to be an ERP or a full accounting suite. We do one thing — chase invoices — and we do it exceptionally well. Setup takes 2 minutes, not 2 hours.',
  },
];

const milestones = [
  {
    year: '2026',
    title: 'ChaseAI is born',
    description: 'Built out of frustration with spending hours writing awkward payment follow-ups. The first version was a simple tool to generate chase emails with AI.',
  },
  {
    year: '2026',
    title: 'Public launch',
    description:
      'ChaseAI launches with AI sequence generation, PDF extraction, automated sending, and paid plans built for freelancers. Enterprise is scoped with customers for integrations, mail workflows, and onboarding.',
  },
  {
    year: 'Next',
    title: 'What\'s ahead',
    description: 'Deeper automation, team collaboration, and more — driven by what Starter, Pro, and Enterprise customers need most.',
  },
];
---

<BaseLayout
  title="About"
  description="Learn about ChaseAI — why we built AI-powered invoice chasing software and our mission to help freelancers and small businesses get paid faster."
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="hero-gradient">
    <div class="container py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-balance leading-[1.1]">
          We believe getting paid
          <span class="gradient-text"> shouldn't be hard</span>
        </h1>
        <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          ChaseAI exists because no one should spend hours writing uncomfortable payment follow-up emails. We built the tool we wished existed — AI that handles the chase, so you can focus on the work.
        </p>
      </div>
    </div>
  </section>

  <!-- The Problem We Solve -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
              The story behind ChaseAI
            </h2>
            <div class="mt-6 space-y-4 text-muted-foreground leading-relaxed">
              <p>
                Every freelancer knows the feeling. You delivered great work, sent the invoice, and then... silence. Days pass. Then weeks. You write a polite follow-up. Nothing. You write another one, this time a bit firmer. Still nothing. Now it's awkward.
              </p>
              <p>
                The worst part isn't the money (though that hurts). It's the emotional cost. The time spent writing and rewriting emails. The anxiety of not knowing if you're being too pushy or too passive. The damage to client relationships when things get tense.
              </p>
              <p>
                We built ChaseAI to solve this exact problem. Our AI writes the emails you'd want to send — professional, contextual, perfectly escalating — so you never have to. You review, approve, and the system handles the rest.
              </p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl border border-border bg-card">
              <div class="text-3xl font-extrabold text-destructive">$825B</div>
              <div class="text-sm text-muted-foreground mt-1">Estimated value of unpaid invoices globally at any given time</div>
            </div>
            <div class="p-5 rounded-2xl border border-border bg-card">
              <div class="text-3xl font-extrabold text-warning">15+ hrs</div>
              <div class="text-sm text-muted-foreground mt-1">Average time freelancers spend per month chasing payments</div>
            </div>
            <div class="p-5 rounded-2xl border border-border bg-card">
              <div class="text-3xl font-extrabold text-foreground">87%</div>
              <div class="text-sm text-muted-foreground mt-1">Of small businesses report being paid late at least once</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          What we stand for
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          The principles that guide every feature we build.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {values.map(v => (
          <div class="p-6 rounded-2xl border border-border bg-card card-hover">
            <div class="text-3xl mb-4">{v.icon}</div>
            <h3 class="text-lg font-semibold mb-2">{v.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Our journey
        </h2>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="space-y-8">
          {milestones.map((m, i) => (
            <div class="flex gap-6">
              <div class="flex flex-col items-center">
                <div class:list={[
                  'flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xs font-bold',
                  i === milestones.length - 1
                    ? 'bg-primary/10 text-primary border-2 border-primary/30'
                    : 'bg-primary text-primary-foreground',
                ]}>
                  {m.year === 'Next' ? '→' : m.year.slice(-2)}
                </div>
                {i < milestones.length - 1 && (
                  <div class="w-px h-full bg-border mt-2"></div>
                )}
              </div>
              <div class="pb-8">
                <div class="text-xs font-medium text-primary mb-1">{m.year}</div>
                <h3 class="text-lg font-semibold">{m.title}</h3>
                <p class="text-sm text-muted-foreground mt-1 leading-relaxed">{m.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Built on modern, reliable technology
        </h2>
        <p class="mt-4 text-muted-foreground">
          Enterprise-grade infrastructure under the hood.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
        {[
          { name: 'Google Gemini AI', desc: 'Sequence generation' },
          { name: 'Supabase', desc: 'Database & auth' },
          { name: 'Resend', desc: 'Email delivery' },
          { name: 'Vercel', desc: 'Hosting & CDN' },
          { name: 'React', desc: 'UI framework' },
          { name: 'TypeScript', desc: 'Type safety' },
          { name: 'Tailwind CSS', desc: 'Styling' },
          { name: 'PostgreSQL', desc: 'Data storage' },
        ].map(tech => (
          <div class="p-4 rounded-xl border border-border bg-card text-center">
            <div class="text-sm font-semibold">{tech.name}</div>
            <div class="text-xs text-muted-foreground mt-0.5">{tech.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding border-t border-border bg-gradient-to-b from-primary/5 to-background">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Join us on the mission
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Every freelancer deserves to get paid on time. Start using ChaseAI today.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={appPricingUrl}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary-600 transition-all hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Subscribe
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold text-foreground hover:bg-muted/50 transition-all w-full sm:w-auto"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
