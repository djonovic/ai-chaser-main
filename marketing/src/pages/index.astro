---
import BaseLayout from '../layouts/BaseLayout.astro';
import thumbSequence from '../assets/lp/sequence-scheduled.png';
import thumbGenerate from '../assets/lp/generate-sequence.png';
import thumbInvoices from '../assets/lp/invoices-list.png';
import thumbDashboard from '../assets/lp/dashboard.png';

const appUrl = 'https://app.chaseai.app';
const appPricingUrl = `${appUrl}/pricing`;

/** Order: dashboard -> invoice list -> invoice detail -> generated sequence (product story left to right) */
const stats = [
  {
    title: 'Automated',
    label: 'Hands-free follow-ups',
    thumb: thumbDashboard,
    lightboxAlt: 'ChaseAI dashboard with overdue total and recent invoices',
  },
  {
    title: 'Personalized',
    label: 'Tailored to every invoice',
    thumb: thumbInvoices,
    lightboxAlt: 'ChaseAI invoices list with search and status filters',
  },
  {
    title: 'Smart Timing',
    label: 'Sent at the perfect moment',
    thumb: thumbGenerate,
    lightboxAlt: 'ChaseAI invoice detail with Smart Chasing, tone selector, and Generate Smart Sequence',
  },
  {
    title: 'Professional',
    label: 'Never damages relationships',
    thumb: thumbSequence,
    lightboxAlt: 'ChaseAI generated chase emails with dates, subjects, and status for each step',
  },
];

const features = [
  {
    icon: '⚡',
    title: 'AI-Written Chase Sequences',
    description:
      'Generates follow-ups that sound like you, not a debt collector. Every message is built to get a reply.',
  },
  {
    icon: '📄',
    title: 'PDF Invoice Reading',
    description: 'Upload any invoice PDF. Client name, amount, due date, and more are extracted instantly.',
  },
  {
    icon: '🎯',
    title: 'Smart Send Timing',
    description: 'Emails go out when clients are most likely to respond. Not too soon, not too late.',
  },
  {
    icon: '📊',
    title: 'Recovery Analytics',
    description:
      'See which invoices are at risk, which sequences are working, and how much you have recovered.',
  },
  {
    icon: '✉️',
    title: 'Automated Email Sending',
    description: 'ChaseAI sends emails on your behalf. See when clients open them with real-time tracking.',
  },
  {
    icon: '👥',
    title: 'Client Management',
    description: 'Every client, invoice, and conversation in one place. Nothing falls through the cracks.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Add Your Invoice',
    description: 'Upload a PDF or enter details manually. ChaseAI reads everything automatically.',
  },
  {
    number: '02',
    title: 'Generate a Sequence',
    description:
      'AI writes a full follow-up sequence matched to the invoice amount, client, and due date.',
  },
  {
    number: '03',
    title: 'Get Paid',
    description:
      'Approve and go. Emails send on schedule. You get notified when payments come in.',
  },
];

const testimonials = [
  {
    quote:
      'I recovered over $4,000 in overdue invoices in my first month. The sequences sound exactly like me and clients actually respond. I wish I had this years ago.',
    name: 'Sarah K.',
    role: 'Freelance designer',
    metric: 'Less time on manual reminders',
  },
  {
    quote:
      'The best thing about ChaseAI is I never have to think about it. Invoices go in, money comes out. It has completely changed how I run my freelance business.',
    name: 'Marcus T.',
    role: 'Agency owner',
    metric: 'Clearer, steadier follow-ups',
  },
  {
    quote:
      'I was scared it would make me look aggressive with clients. Instead my clients now pay faster and still love working with me. The tone is always perfect.',
    name: 'Priya M.',
    role: 'IT consultant',
    metric: 'More predictable workflow',
  },
];

const faqs = [
  {
    q: 'How does ChaseAI generate chase sequences?',
    a: 'It reads your invoice details (client name, amount, overdue period) and writes a series of follow-up emails that escalate naturally. You can edit everything before it sends.',
  },
  {
    q: 'Will it damage my client relationships?',
    a: 'No. This is the first thing we designed for. Every message is professional and warm. The tone protects the relationship while still getting you paid.',
  },
  {
    q: 'Can I use my own email to send?',
    a: 'Yes. Emails are sent on your behalf so every message comes from you. Clients never know AI is involved.',
  },
  {
    q: 'What happens after I upload an invoice?',
    a: 'ChaseAI reads it and generates a full follow-up sequence in seconds. You review, approve, and it handles the rest.',
  },
  {
    q: 'Is there a free plan?',
    a: 'Yes. The Free plan includes 3 invoices per month and 10 AI sequences. No credit card required. Upgrade when you need more.',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ChaseAI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://chaseai.app',
  description: 'AI-powered invoice chasing software that automates payment follow-ups and helps freelancers get paid faster.',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '124',
    bestRating: '5',
  },
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
    { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Starter' },
    { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'Pro' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const structuredData = [softwareSchema, faqSchema];
---

<BaseLayout
  title="ChaseAI"
  description="AI-powered invoice chasing software for freelancers and agencies. Automate payment follow-ups, send professional reminders, and get paid faster. Start free."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-16 md:py-24 lg:py-28">
      <div class="max-w-4xl mx-auto text-center">

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-balance leading-[1.1]">
          Get paid faster.
          <br />
          <span class="gradient-text">Without the awkward follow-ups.</span>
        </h1>

        <p class="mt-5 text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto text-balance leading-relaxed">
          ChaseAI writes and sends professional payment follow-ups for you. You focus on your work. We handle the chasing.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={appUrl}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary-600 transition-all hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Start Free
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3 text-base font-semibold text-foreground hover:bg-muted/50 transition-all w-full sm:w-auto"
          >
            See How It Works
          </a>
        </div>

        <p class="mt-3 text-xs text-muted-foreground">
          1,200+ freelancers and agencies already use ChaseAI
        </p>
      </div>

      <!-- Trust row -->
      <div class="mt-14 md:mt-20 max-w-5xl mx-auto px-4">
        <p class="text-center text-xs font-medium text-muted-foreground uppercase tracking-wider mb-6">
          Why teams use ChaseAI
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-x-8 lg:gap-y-8">
          {stats.map((stat) => (
            <div class="flex flex-col items-center text-center min-w-0 max-w-sm mx-auto w-full">
              <button
                type="button"
                class="group relative w-full max-w-[240px] rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                data-home-lightbox-open
                data-home-lightbox-src={stat.thumb.src}
                data-home-lightbox-alt={stat.lightboxAlt}
              >
                <span class="sr-only">Open larger screenshot: {stat.title}</span>
                <div class="relative overflow-hidden rounded-xl border border-border bg-muted/40 shadow-sm transition-shadow group-hover:shadow-md group-hover:border-primary/25">
                  <img
                    src={stat.thumb.src}
                    width={stat.thumb.width}
                    height={stat.thumb.height}
                    alt=""
                    class="h-[5.5rem] sm:h-24 w-full object-cover object-left-top pointer-events-none"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span
                  class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-primary/90 group-hover:text-primary"
                  aria-hidden="true"
                >
                  <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                    />
                  </svg>
                  Enlarge
                </span>
              </button>
              <h3 class="mt-3 text-lg sm:text-xl font-bold text-foreground tracking-tight leading-snug px-1 break-words w-full">
                {stat.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-1.5 leading-snug px-1 max-w-[13rem] mx-auto">
                {stat.label}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="border-t border-border bg-muted/30 section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Unpaid invoices cost more than money
        </h2>
        <p class="mt-3 text-lg text-muted-foreground">
          Chasing payments manually drains your time and damages relationships.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="text-center p-5 rounded-2xl bg-background border border-border">
          <div class="text-lg font-bold text-destructive">Hours lost every week</div>
          <div class="text-sm text-muted-foreground mt-2">Writing follow-up emails one by one is a job you never signed up for.</div>
        </div>
        <div class="text-center p-5 rounded-2xl bg-background border border-border">
          <div class="text-lg font-bold text-warning">Clients go quiet</div>
          <div class="text-sm text-muted-foreground mt-2">Generic reminders get ignored. The wrong tone pushes clients away.</div>
        </div>
        <div class="text-center p-5 rounded-2xl bg-background border border-border">
          <div class="text-lg font-bold text-foreground">Cash flow stalls</div>
          <div class="text-sm text-muted-foreground mt-2">Late payments slow down everything: bills, payroll, and growth.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="section-padding" id="features">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Everything you need to get paid on time
        </h2>
        <p class="mt-3 text-lg text-muted-foreground">
          Built for freelancers, consultants, and small businesses.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {features.map(feature => (
          <div class="group p-6 rounded-2xl border border-border bg-card card-hover">
            <div class="text-3xl mb-4">{feature.icon}</div>
            <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Three steps to getting paid
        </h2>
        <p class="mt-3 text-lg text-muted-foreground">
          From upload to payment in minutes, not weeks.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8 md:gap-10">
          {steps.map((step, i) => (
            <div class="relative">
              {i < steps.length - 1 && (
                <div class="hidden md:block absolute top-8 left-full w-full h-px border-t-2 border-dashed border-border -translate-x-1/2" />
              )}
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground font-bold text-lg mb-5">
                {step.number}
              </div>
              <h3 class="text-xl font-semibold mb-2">{step.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AI Demo Preview -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary mb-4">
              AI-Powered
            </div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
              Follow-ups that actually get responses
            </h2>
            <p class="mt-3 text-muted-foreground leading-relaxed">
              Most reminders get deleted. ChaseAI writes messages that sound human, clear, and professional so clients actually open and act on them.
            </p>

            <ul class="mt-6 space-y-3">
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div class="text-sm font-medium pt-0.5">Reads tone from your invoice and client history</div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div class="text-sm font-medium pt-0.5">Adjusts urgency as the due date passes</div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div class="text-sm font-medium pt-0.5">Never sounds robotic or threatening</div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div class="text-sm font-medium pt-0.5">Full preview and edit before anything sends</div>
              </li>
            </ul>
          </div>

          <!-- Mock Email Preview -->
          <div class="relative">
            <div class="rounded-2xl border border-border bg-card shadow-2xl shadow-primary/5 overflow-hidden">
              <div class="bg-muted/50 px-4 py-3 border-b border-border flex items-center gap-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-destructive/60"></div>
                  <div class="w-3 h-3 rounded-full bg-warning/60"></div>
                  <div class="w-3 h-3 rounded-full bg-success/60"></div>
                </div>
                <span class="text-xs text-muted-foreground ml-2">Smart Chase Sequence</span>
              </div>
              <div class="p-5 space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">1</div>
                  <div>
                    <div class="text-sm font-medium">Friendly Reminder</div>
                    <div class="text-xs text-muted-foreground">Day 1 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-success/10 text-success border border-success/30 px-2 py-0.5 text-[10px] font-medium">Sent</span>
                  </div>
                </div>
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">2</div>
                  <div>
                    <div class="text-sm font-medium">Professional Follow-Up</div>
                    <div class="text-xs text-muted-foreground">Day 4 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-warning/10 text-warning border border-warning/30 px-2 py-0.5 text-[10px] font-medium">Scheduled</span>
                  </div>
                </div>
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">3</div>
                  <div>
                    <div class="text-sm font-medium">Firm Notice</div>
                    <div class="text-xs text-muted-foreground">Day 8 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-muted text-muted-foreground px-2 py-0.5 text-[10px] font-medium">Pending</span>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">4</div>
                  <div>
                    <div class="text-sm font-medium">Final Demand</div>
                    <div class="text-xs text-muted-foreground">Day 14 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-muted text-muted-foreground px-2 py-0.5 text-[10px] font-medium">Pending</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -z-10 inset-0 translate-x-4 translate-y-4 rounded-2xl bg-primary/5 border border-primary/10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Section -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Manual chasing vs. ChaseAI
        </h2>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="rounded-2xl border border-border bg-card overflow-hidden">
          <div class="grid grid-cols-3 bg-muted/50 border-b border-border">
            <div class="px-4 py-3 text-sm font-semibold">What you get</div>
            <div class="px-4 py-3 text-sm font-semibold text-center">Doing it yourself</div>
            <div class="px-4 py-3 text-sm font-semibold text-center text-primary">ChaseAI</div>
          </div>
          {[
            ['Time spent on follow-ups', '3 to 5 hours a week', 'Under 5 minutes'],
            ['Follow-up consistency', 'Easy to forget', 'Never misses one'],
            ['Message quality', 'Hit or miss', 'Professional every time'],
            ['Tone control', 'Too harsh or too soft', 'Always calibrated'],
            ['Awkwardness', 'Every single time', 'Zero, handled for you'],
          ].map(([feature, manual, chase], i) => (
            <div class:list={['grid grid-cols-3', i % 2 === 0 ? 'bg-card' : 'bg-muted/20']}>
              <div class="px-4 py-3 text-sm font-medium">{feature}</div>
              <div class="px-4 py-3 text-sm text-muted-foreground text-center">{manual}</div>
              <div class="px-4 py-3 text-sm text-center font-medium text-success">{chase}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Real results from real users
        </h2>
        <p class="mt-3 text-lg text-muted-foreground">
          Freelancers and agencies rely on ChaseAI to protect cash flow and client relationships.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {testimonials.map(t => (
          <div class="p-6 rounded-2xl border border-border bg-card">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="h-4 w-4 text-warning fill-warning" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <blockquote class="text-sm text-foreground leading-relaxed mb-4">
              "{t.quote}"
            </blockquote>
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary text-sm font-bold">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="text-sm font-medium">{t.name}</div>
                <div class="text-xs text-muted-foreground">{t.role}</div>
              </div>
            </div>
            <div class="mt-3 inline-flex items-center gap-1 rounded-full bg-success/10 text-success text-xs font-medium px-2.5 py-1">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              {t.metric}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Preview -->
  <section class="section-padding border-t border-border bg-muted/30" id="pricing">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Pays for itself with one recovered invoice
        </h2>
        <p class="mt-3 text-lg text-muted-foreground">
          Start free, upgrade when you need more. Cancel anytime.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- Free -->
        <div class="p-6 rounded-2xl border border-border bg-card relative">
