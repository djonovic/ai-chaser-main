---
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.chaseai.app';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ChaseAI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'AI-powered invoice chasing software that automates payment follow-ups and gets you paid faster.',
  offers: [
    { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
    { '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Starter', billingIncrement: 'P1M' },
    { '@type': 'Offer', price: '49', priceCurrency: 'USD', name: 'Pro', billingIncrement: 'P1M' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '127',
    bestRating: '5',
  },
};

const stats = [
  { value: '94%', label: 'Collection rate' },
  { value: '5x', label: 'Faster payments' },
  { value: '$14k+', label: 'Avg recovered/mo' },
  { value: '0 hrs', label: 'Manual chasing' },
];

const features = [
  {
    icon: '⚡',
    title: 'AI-Generated Chase Sequences',
    description: 'One click generates a multi-step email sequence perfectly calibrated to your invoice — amount, days overdue, and client relationship.',
  },
  {
    icon: '📄',
    title: 'PDF Invoice Extraction',
    description: 'Drop a PDF invoice and our AI extracts client name, amount, due date, and more. No manual data entry.',
  },
  {
    icon: '🎯',
    title: 'Smart Tone Escalation',
    description: 'Start friendly, get firm. Choose from professional, friendly, firm, or humorous tones. AI adapts the escalation perfectly.',
  },
  {
    icon: '📊',
    title: 'Recovery Analytics',
    description: 'Track total recovered, success rates, and days to payment. See exactly which sequences perform best.',
  },
  {
    icon: '✉️',
    title: 'Automated Email Sending',
    description: 'Once you approve the sequence, emails fire automatically on schedule. Pause, resume, or stop anytime.',
  },
  {
    icon: '👥',
    title: 'Client Management',
    description: 'Keep all your clients organized with contact details, invoice history, and communication preferences in one place.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Add Your Invoice',
    description: 'Upload a PDF or enter details manually. AI extracts everything automatically — client, amount, due date.',
  },
  {
    number: '02',
    title: 'Generate AI Sequence',
    description: 'One click creates a personalized multi-step chase sequence. Review the emails, edit if you want, approve.',
  },
  {
    number: '03',
    title: 'Get Paid Automatically',
    description: 'Emails send on schedule. When your client pays, mark it done. Track everything from your dashboard.',
  },
];

const testimonials = [
  {
    quote: "I used to spend hours every week writing awkward follow-up emails. ChaseAI generates the perfect sequence in seconds — and my clients actually pay faster now.",
    name: 'Sarah K.',
    role: 'Freelance Designer',
    metric: '$12,400 recovered in month 1',
  },
  {
    quote: "The AI tone escalation is genius. It starts gentle and gets firm at exactly the right pace. I haven't had a single client complaint, and my collection rate went from 65% to 94%.",
    name: 'Marcus T.',
    role: 'Agency Owner',
    metric: '94% collection rate',
  },
  {
    quote: "As a solo consultant, chasing invoices was the worst part of my job. ChaseAI removed me from the equation entirely. I just review the AI emails and hit start.",
    name: 'Priya M.',
    role: 'IT Consultant',
    metric: '15+ hours saved per month',
  },
];

const faqs = [
  {
    q: 'How does the AI generate chase sequences?',
    a: 'ChaseAI uses Google Gemini AI to analyze your invoice details — client name, amount, days overdue, and your preferred tone — then generates a multi-step email sequence with perfectly escalating messaging. Each email is unique and contextual.',
  },
  {
    q: 'Will automated reminders damage my client relationships?',
    a: 'The opposite. Our AI crafts professional, context-aware messages that maintain your relationship while getting results. You can review and edit every email before it sends. Most clients appreciate the clear, professional communication.',
  },
  {
    q: 'Can I use my own AI API key?',
    a: 'Yes. ChaseAI supports Bring Your Own Key (BYOK) — add your free Google Gemini API key in Settings to get unlimited AI sequence generation on any plan, including Free.',
  },
  {
    q: 'What happens after I generate a sequence?',
    a: 'You get to review every email in the sequence before anything sends. Edit subjects, body text, or send dates. When you\'re happy, click Start Smart Chasing and emails fire automatically on your schedule.',
  },
  {
    q: 'Is there a free plan?',
    a: 'Yes. The Free plan includes 3 invoices per month, 10 AI sequence generations, and a basic dashboard. No credit card required. Upgrade to Starter ($29/mo) or Pro ($49/mo) when you need more.',
  },
];
---

<BaseLayout
  title="ChaseAI"
  description="Stop chasing invoices manually. ChaseAI uses AI to generate personalized payment follow-up sequences that get you paid 5x faster. Free plan available."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="container py-20 md:py-28 lg:py-36">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm font-medium text-primary mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          AI-powered invoice chasing is here
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-balance leading-[1.1]">
          Stop chasing invoices.
          <br />
          <span class="gradient-text">Start getting paid.</span>
        </h1>

        <p class="mt-6 text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto text-balance leading-relaxed">
          ChaseAI generates personalized, AI-crafted payment follow-up sequences that escalate at the perfect pace. Your clients pay faster. You never write another awkward reminder.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`${appUrl}/auth`}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary-600 transition-all hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Start Free — No Credit Card
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold text-foreground hover:bg-muted/50 transition-all w-full sm:w-auto"
          >
            See How It Works
          </a>
        </div>

        <p class="mt-4 text-xs text-muted-foreground">
          Free forever plan available &middot; No credit card required &middot; Setup in 2 minutes
        </p>
      </div>

      <!-- Stats Bar -->
      <div class="mt-16 md:mt-24 max-w-3xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          {stats.map(stat => (
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-extrabold text-foreground">{stat.value}</div>
              <div class="text-sm text-muted-foreground mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="border-t border-border bg-muted/30 section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Late payments are killing your cash flow
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          The average freelancer is owed thousands in overdue invoices. Chasing them manually is uncomfortable, inconsistent, and takes hours you'll never get back.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center p-6 rounded-2xl bg-background border border-border">
          <div class="text-4xl font-extrabold text-destructive">15+</div>
          <div class="text-sm text-muted-foreground mt-2">hours per month spent chasing invoices</div>
        </div>
        <div class="text-center p-6 rounded-2xl bg-background border border-border">
          <div class="text-4xl font-extrabold text-warning">61%</div>
          <div class="text-sm text-muted-foreground mt-2">average manual collection rate</div>
        </div>
        <div class="text-center p-6 rounded-2xl bg-background border border-border">
          <div class="text-4xl font-extrabold text-foreground">1 in 3</div>
          <div class="text-sm text-muted-foreground mt-2">businesses lose a client after chasing</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="section-padding" id="features">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Everything you need to get paid faster
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          AI-powered tools designed for freelancers, consultants, and small businesses who are tired of chasing payments.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {features.map(feature => (
          <div class="group p-6 rounded-2xl border border-border bg-card card-hover">
            <div class="text-3xl mb-4">{feature.icon}</div>
            <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Get paid in 3 simple steps
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          From overdue invoice to money in your account — in minutes, not weeks.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8 md:gap-12">
          {steps.map((step, i) => (
            <div class="relative">
              {i < steps.length - 1 && (
                <div class="hidden md:block absolute top-8 left-full w-full h-px border-t-2 border-dashed border-border -translate-x-1/2" />
              )}
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground font-bold text-lg mb-5">
                {step.number}
              </div>
              <h3 class="text-xl font-semibold mb-2">{step.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AI Demo Preview -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary mb-4">
              AI-Powered
            </div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
              AI writes the perfect chase sequence for every invoice
            </h2>
            <p class="mt-4 text-muted-foreground leading-relaxed">
              No templates. No copy-paste. Our AI analyzes your invoice details — amount, days overdue, client relationship — and generates a unique, multi-step email sequence with perfectly escalating tone.
            </p>

            <ul class="mt-8 space-y-4">
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <div class="text-sm font-medium">Contextual & personalized</div>
                  <div class="text-xs text-muted-foreground">Every email references the specific invoice, amount, and client name</div>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <div class="text-sm font-medium">Tone escalation built in</div>
                  <div class="text-xs text-muted-foreground">Starts gentle, gets progressively firmer — you pick the style</div>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success/10 text-success mt-0.5">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                  <div class="text-sm font-medium">Full control before sending</div>
                  <div class="text-xs text-muted-foreground">Review, edit, reschedule every email. Nothing sends without your approval.</div>
                </div>
              </li>
            </ul>
          </div>

          <!-- Mock Email Preview -->
          <div class="relative">
            <div class="rounded-2xl border border-border bg-card shadow-2xl shadow-primary/5 overflow-hidden">
              <div class="bg-muted/50 px-4 py-3 border-b border-border flex items-center gap-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-destructive/60"></div>
                  <div class="w-3 h-3 rounded-full bg-warning/60"></div>
                  <div class="w-3 h-3 rounded-full bg-success/60"></div>
                </div>
                <span class="text-xs text-muted-foreground ml-2">Smart Chase Sequence</span>
              </div>
              <div class="p-5 space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">1</div>
                  <div>
                    <div class="text-sm font-medium">Friendly Reminder</div>
                    <div class="text-xs text-muted-foreground">Day 1 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-success/10 text-success border border-success/30 px-2 py-0.5 text-[10px] font-medium">Sent</span>
                  </div>
                </div>
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">2</div>
                  <div>
                    <div class="text-sm font-medium">Professional Follow-Up</div>
                    <div class="text-xs text-muted-foreground">Day 4 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-warning/10 text-warning border border-warning/30 px-2 py-0.5 text-[10px] font-medium">Scheduled</span>
                  </div>
                </div>
                <div class="flex items-center gap-3 pb-3 border-b border-border">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">3</div>
                  <div>
                    <div class="text-sm font-medium">Firm Notice</div>
                    <div class="text-xs text-muted-foreground">Day 8 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-muted text-muted-foreground px-2 py-0.5 text-[10px] font-medium">Pending</span>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center h-8 w-8 rounded-full bg-primary/10 text-primary text-xs font-bold">4</div>
                  <div>
                    <div class="text-sm font-medium">Final Demand</div>
                    <div class="text-xs text-muted-foreground">Day 14 &middot; Email</div>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center rounded-full bg-muted text-muted-foreground px-2 py-0.5 text-[10px] font-medium">Pending</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -z-10 inset-0 translate-x-4 translate-y-4 rounded-2xl bg-primary/5 border border-primary/10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Section -->
  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          ChaseAI vs. doing it manually
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          The numbers make the case — clearly.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="rounded-2xl border border-border bg-card overflow-hidden">
          <div class="grid grid-cols-3 bg-muted/50 border-b border-border">
            <div class="px-4 py-3 text-sm font-semibold">Feature</div>
            <div class="px-4 py-3 text-sm font-semibold text-center">Manual</div>
            <div class="px-4 py-3 text-sm font-semibold text-center text-primary">ChaseAI</div>
          </div>
          {[
            ['Setup time', '∞ Ongoing', '2 minutes'],
            ['Collection rate', '~61%', '~94%'],
            ['Time per invoice', '45–90 min', '0 minutes'],
            ['Consistency', 'Inconsistent', 'Every time'],
            ['Tone escalation', 'Manual guesswork', 'AI-optimized'],
            ['Analytics', 'Spreadsheets', 'Real-time dashboard'],
            ['Awkward conversations', 'Yes', 'Never'],
          ].map(([feature, manual, chase], i) => (
            <div class:list={['grid grid-cols-3', i % 2 === 0 ? 'bg-card' : 'bg-muted/20']}>
              <div class="px-4 py-3 text-sm font-medium">{feature}</div>
              <div class="px-4 py-3 text-sm text-muted-foreground text-center">{manual}</div>
              <div class="px-4 py-3 text-sm text-center font-medium text-success">{chase}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-padding">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Trusted by freelancers and businesses
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Real results from people who stopped chasing payments.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {testimonials.map(t => (
          <div class="p-6 rounded-2xl border border-border bg-card">
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg class="h-4 w-4 text-warning fill-warning" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <blockquote class="text-sm text-foreground leading-relaxed mb-4">
              "{t.quote}"
            </blockquote>
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary text-sm font-bold">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="text-sm font-medium">{t.name}</div>
                <div class="text-xs text-muted-foreground">{t.role}</div>
              </div>
            </div>
            <div class="mt-3 inline-flex items-center gap-1 rounded-full bg-success/10 text-success text-xs font-medium px-2.5 py-1">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              {t.metric}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Preview -->
  <section class="section-padding border-t border-border bg-muted/30" id="pricing">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Simple, transparent pricing
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          Start free. Upgrade when you're ready to automate. Cancel anytime.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <!-- Free -->
        <div class="p-6 rounded-2xl border border-border bg-card">
          <div class="text-sm font-medium text-muted-foreground mb-1">Free</div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="text-4xl font-extrabold">$0</span>
            <span class="text-muted-foreground">/mo</span>
          </div>
          <p class="text-sm text-muted-foreground mb-6">For getting started</p>
          <ul class="space-y-3 mb-8">
            {['3 invoices per month', 'Automated email sending', '10 AI sequences/month', 'Basic dashboard'].map(f => (
              <li class="flex items-center gap-2 text-sm">
                <svg class="h-4 w-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={`${appUrl}/auth`}
            class="inline-flex items-center justify-center w-full rounded-lg border border-border px-4 py-2.5 text-sm font-semibold hover:bg-muted/50 transition-colors"
          >
            Get Started Free
          </a>
        </div>

        <!-- Starter (highlighted) -->
        <div class="p-6 rounded-2xl border-2 border-primary bg-card shadow-lg shadow-primary/10 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="inline-flex items-center gap-1 rounded-full bg-primary text-primary-foreground px-3 py-1 text-xs font-semibold">
              Most Popular
            </span>
          </div>
          <div class="text-sm font-medium text-primary mb-1">Starter</div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="text-4xl font-extrabold">$29</span>
            <span class="text-muted-foreground">/mo</span>
          </div>
          <p class="text-sm text-muted-foreground mb-6">For serious freelancers</p>
          <ul class="space-y-3 mb-8">
            {['Unlimited invoices', '50 AI sequences/month', 'Advanced reports', 'Multi-currency support'].map(f => (
              <li class="flex items-center gap-2 text-sm">
                <svg class="h-4 w-4 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {f}
              </li>
