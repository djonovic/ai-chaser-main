  <!-- Lightbox for homepage trust screenshots (Meta / cold traffic: small previews, full size on demand) -->
  <div
    id="home-lightbox"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Screenshot preview"
  >
    <button
      type="button"
      id="home-lightbox-backdrop"
      class="absolute inset-0 bg-black/80 backdrop-blur-sm"
      aria-label="Close preview"
    ></button>
    <div class="relative z-10 w-full max-w-5xl max-h-[90vh] flex flex-col items-stretch gap-3">
      <div class="flex justify-end">
        <button
          type="button"
          id="home-lightbox-close"
          class="rounded-lg bg-background/95 border border-border px-3 py-1.5 text-sm font-medium text-foreground shadow-md hover:bg-muted transition-colors"
        >
          Close
        </button>
      </div>
      <div class="rounded-xl border border-border bg-background shadow-2xl overflow-hidden overflow-y-auto max-h-[calc(90vh-3.5rem)]">
        <img id="home-lightbox-img" src="" alt="" class="w-full h-auto block" />
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.getElementById('home-lightbox');
      var img = document.getElementById('home-lightbox-img');
      var backdrop = document.getElementById('home-lightbox-backdrop');
      var closeBtn = document.getElementById('home-lightbox-close');
      if (!root || !img || !backdrop || !closeBtn) return;

      function openLightbox(src, alt) {
        img.src = src;
        img.alt = alt || 'Product screenshot';
        root.classList.remove('hidden');
        root.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        root.classList.add('hidden');
        root.classList.remove('flex');
        document.body.style.overflow = '';
        img.removeAttribute('src');
        img.alt = '';
      }

      document.querySelectorAll('[data-home-lightbox-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var src = btn.getAttribute('data-home-lightbox-src');
          var alt = btn.getAttribute('data-home-lightbox-alt') || '';
          if (src) openLightbox(src, alt);
        });
      });

      backdrop.addEventListener('click', closeLightbox);
      closeBtn.addEventListener('click', closeLightbox);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !root.classList.contains('hidden')) closeLightbox();
      });
    })();
  </script>
