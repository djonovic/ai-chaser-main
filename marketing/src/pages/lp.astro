---
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.chaseai.app';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'ChaseAI - Invoice chasing',
    description:
    'AI-assisted payment reminders you review before they send. Start free, upgrade when you need more.',
  url: 'https://chaseai.app/lp',
};
---

<BaseLayout
  title="Get Paid Faster Without Awkward Follow-Ups | ChaseAI"
  description="Generate and send professional overdue invoice reminders with AI. Reduce manual chasing time and recover payments faster with ChaseAI."
  structuredData={structuredData}
  noindex={true}
>
  <section class="hero-gradient">
    <div class="container py-16 md:py-24 max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-balance">
        Invoice reminders that sound like you, without living in your inbox
      </h1>
      <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
        ChaseAI generates multi-step sequences from your invoice details, or lets you start from built-in templates. Nothing sends until you approve.
        Pricing is in the app with Stripe; you get receipts and can cancel from Settings.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={appUrl}
          class="inline-flex items-center justify-center rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 hover:opacity-95 transition-opacity w-full sm:w-auto"
        >
          Start Free
        </a>
        <a
          href="/pricing"
          class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3.5 text-base font-semibold hover:bg-muted/50 transition-colors w-full sm:w-auto"
        >
          See plans
        </a>
      </div>
      <p class="mt-6 text-xs text-muted-foreground max-w-md mx-auto">
        Free plan includes 1 invoice and 1 sequence generation/month. Upgrade anytime for more capacity.
      </p>
    </div>
  </section>

  <section class="section-padding border-t border-border bg-muted/30">
    <div class="container max-w-3xl mx-auto space-y-8">
      <h2 class="text-2xl font-bold text-center">Why teams trust this approach</h2>
      <ul class="space-y-4 text-sm text-muted-foreground">
        <li class="flex gap-3">
          <span class="text-primary font-bold">1.</span>
          <span><strong class="text-foreground">You stay accountable.</strong> Editable drafts mean clients only see language you would stand behind.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-primary font-bold">2.</span>
          <span><strong class="text-foreground">Straightforward billing.</strong> Checkout runs in the app; questions go to a real support inbox.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-primary font-bold">3.</span>
          <span><strong class="text-foreground">Start free, upgrade when ready.</strong> No credit card required. Paid plans unlock unlimited invoices and more sequence generations.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-padding border-t border-border">
    <div class="container max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold">Simple next step</h2>
      <p class="mt-3 text-sm text-muted-foreground">
        Try our Free AI Overdue Invoice Sequence Generator - no sign-up required.
      </p>
      <a href="/tools/overdue-invoice-sequence-generator" class="mt-5 inline-flex items-center justify-center rounded-lg bg-primary px-7 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary-600 transition-colors">
        Open the free tool
      </a>
    </div>
  </section>
</BaseLayout>
